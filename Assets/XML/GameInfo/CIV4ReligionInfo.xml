			<GenericTechButton>,Art/Interface/Buttons/TechTree/Polytheism.dds,Art/Interface/Buttons/TechTree_Atlas.dds,7,6</GenericTechButton>
			<MovieFile>Art/AdvCiv_SAS/Religions/Paganism/nif_found/Generic_Found.nif</MovieFile>
			<MovieSound>AS2D_BUILD_PAGAN_MOVIE</MovieSound>
			<Sound>AS2D_BUILD_PAGAN</Sound>
		</ReligionInfo>
