+bool CvUnitAI::AI_pickupStranded(UnitAITypes eUnitAI)
+{
+	PROFILE_FUNC();
+
+	CvPlot* pBestPlot;
+	CvUnit* pBestUnit;
+	CvPlot* pBestPickupPlot;
+	int iPathTurns;
+	int iValue;
+	int iBestValue;
+	int iLoop;
+	int iCount;
+
+	FAssert(cargoSpace() > 0);
+	if (0 == cargoSpace())
+	{
+		return false;
+	}
+
+	iBestValue = 0;
+	pBestPlot = NULL;
+	pBestUnit = NULL;
+	pBestPickupPlot = NULL;
+
+	int iI;
+	CvUnit* pLoopUnit = NULL;
+	CvPlot* pLoopPlot = NULL;
+	CvArea* pLoopArea = NULL;
+	CvPlot* pPickupPlot = NULL;
+	CvPlot* pAdjacentPlot = NULL;
+	CvPlayerAI& kPlayer = GET_PLAYER(getOwnerINLINE());
+
+	int iMaxFortifyTurns = GC.getDefineINT("MAX_FORTIFY_TURNS");
+
+	for(pLoopUnit = kPlayer.firstUnit(&iLoop); pLoopUnit != NULL; pLoopUnit = kPlayer.nextUnit(&iLoop))
+	{
+		if( pLoopUnit->getGroup()->getHeadUnit() != pLoopUnit )
+		{
+			continue;
+		}
+
+		if( pLoopUnit->getFortifyTurns() < iMaxFortifyTurns )
+		{
+			continue;
+		}
+
+		if( !pLoopUnit->getGroup()->canAllMove() )
+		{
+			continue;
+		}
+
+		if( pLoopUnit->getGroup()->AI_getMissionAIType() != NO_MISSIONAI )
+		{
+			continue;
+		}
+
+		if( pLoopUnit->getGroup()->getLengthMissionQueue() > 0 )
+		{
+			continue;
+		}
+
+		pLoopPlot = pLoopUnit->plot();
+		if( pLoopPlot != NULL )
+		{
+			if( pLoopPlot->area()->getCitiesPerPlayer(getOwnerINLINE()) )
+			{
+				continue;
+			}
+
+			if( pLoopPlot->isHasPathToEnemyCity(getTeam()) )
+			{
+				continue;
+			}
+
+			iCount = pLoopUnit->getGroup()->getNumUnits();
