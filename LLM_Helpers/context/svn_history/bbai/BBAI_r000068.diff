+void CvGameTextMgr::setCityPlotYieldValueString(CvWString &szString, CvCity* pCity, int iIndex, bool bAvoidGrowth, bool bIgnoreGrowth, bool bIgnoreFood)
+{
+	CvPlot* pPlot = NULL;
+	
