+// extraSaveData.cpp
+
+#include "CvGameCoreDLL.h"
+#include "CvExtraSaveData.h"
+#include "CvMap.h"
+#include "CvPlot.h"
+#include "CvTeamAI.h"
+#include "CvPlayerAI.h"
