+class Tester :
+
+    def __init__(self, customEM):
+
+        print "Initializing Tester"
+
+        self.LOG_DEBUG = True
+
+        customEM.addEventHandler( "kbdEvent", self.onKbdEvent )
+
+        self.customEM = customEM
+
+    def removeEventHandlers( self ) :
+        print "Removing event handlers from Tester"
