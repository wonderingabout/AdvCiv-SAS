+int CvPlayerAI::AI_getVictoryStrategyHash() const
+{
+    if ((m_iVictoryStrategyHash != 0) && (m_iVictoryStrategyHashCacheTurn == GC.getGameINLINE().getGameTurn()))
+    {
+        return m_iVictoryStrategyHash;        
+    }
