+                //{
+                	m_iVictoryStrategyHash |= AI_VICTORY_DOMINATION4; 
+                }
+            }
+	    }
+	}
+
+	// Diplomacy victory
+	iVictoryStage = AI_getDiplomacyVictoryStage();
+
+	if( iVictoryStage >= 1 )
+	{
+		m_iVictoryStrategyHash |= AI_VICTORY_DIPLOMACY1;
+	    if (iVictoryStage > 1)
+	    {
