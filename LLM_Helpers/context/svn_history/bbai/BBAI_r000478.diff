+			}
+
+			int iMax = 100*std::abs(GC.getDefineINT("BBAI_RESEARCH_PERCENT_ADJUST_MAX_PERCENT"));
+			m_iResearchPercentAdjustTimes100 = std::min( m_iResearchPercentAdjustTimes100, iMax );
+			m_iResearchPercentAdjustTimes100 = std::max( m_iResearchPercentAdjustTimes100, -iMax );
+		}
+	}
