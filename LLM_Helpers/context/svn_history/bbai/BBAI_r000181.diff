+
+bool CvExtraSaveData::popNode(CvMap& kMap, int iIndex, CvExtraSaveDataNode& node)
+{
+	bool bValid = true;
+	
+	if (bValid)
+	{
+		bValid = popFromFoundValues(kMap, iIndex++, node.iValue);
