+	CvCity* pLoopCity;
+	int iLoop;
+	int iValue;
+	
+	FAssert(GET_PLAYER(eIndex).isAlive());
+	FAssert(eIndex != getID());
+	
+	iValue = 0;
+	for (pLoopCity = GET_PLAYER(eIndex).firstCity(&iLoop); pLoopCity != NULL; pLoopCity = GET_PLAYER(eIndex).nextCity(&iLoop))
