+	case GAMEMESSAGE_AUTO_MOVES:
+		return new CvNetAutoMoves();
+	case GAMEMESSAGE_TURN_COMPLETE:
+		return new CvNetTurnComplete();
+	case GAMEMESSAGE_PUSH_ORDER:
