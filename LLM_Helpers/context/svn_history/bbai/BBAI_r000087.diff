+void CvSelectionGroup::mergeIntoGroup(CvSelectionGroup* pSelectionGroup, bool bRemoveSelected, bool bRejoin)
+{
+	CLLNode<IDInfo>* pUnitNode = headUnitNode();
+	while (pUnitNode != NULL)
+	{
+		CvUnit* pLoopUnit = ::getUnit(pUnitNode->m_data);
+		pUnitNode = nextUnitNode(pUnitNode);
+		
+		if (pLoopUnit != NULL)
+			pLoopUnit->joinGroup(pSelectionGroup, bRemoveSelected, bRejoin);
+	}
+}
