+inline void rangeIndexToXY(const int iRange, const int iIndex, int &iDX, int &iDY)
+{
+	//for (int iIndex = 0; iIndex < iPlotsAtThisRange; iIndex++)
+
+	iDX = 0;
+	iDY = 0;
+	
+	// set index
+	if (iRange > 0)
+	{
+		int iDiameter = (iRange * 2) + 1;
+		int iCheck = iIndex;
+		
+		// top row
+		iCheck -= iDiameter;
+		if (iCheck < 0)
+		{
+			iDX = iCheck + iRange + 1;
+			iDY = -iRange;
+		}
+		else
+		{
+			// bottom row
+			iCheck -= iDiameter;
+			if (iCheck < 0)
+			{
+				iDX = iCheck + iRange + 1;
+				iDY = iRange;
+			}
+			else
+			{
+				// the columns are 2 shorter, so we do not count the same plot twice
+				iDiameter -= 2;
+				
+				// left column
+				iCheck -= iDiameter;
+				if (iCheck < 0)
+				{
+					iDX = -iRange;
+					iDY = iCheck + iRange;
+				}
+				else
+				{
+					// right column
+					iCheck -= iDiameter;
+					if (iCheck < 0)
+					{
+						iDX = iRange;
+						iDY = iCheck + iRange;
+					}
+					else
+					{
+						FAssertMsg(true, "bad index to rangeIndexToXY");
+					}
+
+				}
+
+			}
+		}
+	}
+}
