+
+bool CvUnit::recon(int iX, int iY)
+{
+	CvPlot* pPlot;
+
+	if (!canReconAt(plot(), iX, iY))
+	{
+		return false;
+	}
+
+	pPlot = GC.getMapINLINE().plotINLINE(iX, iY);
+
+	setReconPlot(pPlot, ((airRange() + 1) / 2));
+
+	finishMoves();
+
