+			if (GET_PLAYER((PlayerTypes)iI).getTeam() == getID())
+			{
+				iRand += GC.getLeaderHeadInfo(GET_PLAYER((PlayerTypes)iI).getPersonalityType()).getNoTechTradeThreshold();
+				iCount++;
+			}
+		}
+	}
+
+	if (iCount > 0)
+	{
+		iRand /= iCount;
+	}
+
+	return iRand;
+}
