+bool CvPlot::isAdjacentTeam(TeamTypes eTeam, bool bLandOnly) const
+{
+	CvPlot* pAdjacentPlot;
+	int iI;
+
+	for (iI = 0; iI < NUM_DIRECTION_TYPES; iI++)
+	{
