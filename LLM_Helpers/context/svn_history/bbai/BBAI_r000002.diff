+
+	if (getGroup()->getNumUnits() > 1)
+	{
+		return false;
+	}
+
+	pCity = plot()->getPlotCity();
+
+	if (pCity == NULL)
+	{
+		return false;
+	}
+
+	if (pCity->getMaxAirlift() == 0)
+	{
+		return false;
+	}
+
+	iBestValue = 0;
+	pBestPlot = NULL;
+
+	for (pLoopCity = GET_PLAYER(getOwnerINLINE()).firstCity(&iLoop); pLoopCity != NULL; pLoopCity = GET_PLAYER(getOwnerINLINE()).nextCity(&iLoop))
