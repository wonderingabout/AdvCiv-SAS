+
+	pStream->Write(m_iMissionAIX);
+	pStream->Write(m_iMissionAIY);
+
+	pStream->Write(m_bForceSeparate);
+
+	pStream->Write(m_eMissionAIType);
+
+	pStream->Write(m_missionAIUnit.eOwner);
+	pStream->Write(m_missionAIUnit.iID);
+}
