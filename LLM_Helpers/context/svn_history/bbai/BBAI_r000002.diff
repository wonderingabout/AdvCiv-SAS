+bool CvCity::canBeSelected() const
+{
+	if ((getTeam() == GC.getGameINLINE().getActiveTeam()) || GC.getGameINLINE().isDebugMode())
+	{
+		return true;
+	}
+
+	if (GC.getGameINLINE().getActiveTeam() != NO_TEAM)
+	{
+		if (plot()->isInvestigate(GC.getGameINLINE().getActiveTeam()))
+		{
+			return true;
+		}
+	}
+
+	return false;
+}
