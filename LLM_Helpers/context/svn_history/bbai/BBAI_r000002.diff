+
+	if (!bValid)
+	{
+		return false;
+	}
+
+	pAttacker = gDLL->getInterfaceIFace()->getSelectionList()->AI_getBestGroupAttacker(pPlot, false);
+
+	if (pAttacker == NULL)
+	{
+		pAttacker = gDLL->getInterfaceIFace()->getSelectionList()->AI_getBestGroupAttacker(pPlot, false, true);
+	}
+
