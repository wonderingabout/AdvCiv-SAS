+			}
+		}
+		for (it = m_listPopups.begin(); it != m_listPopups.end(); it++)
+		{
+			CvPopupInfo* pInfo = *it;
+			if (NULL != pInfo)
+			{
+				pInfo->write(*pStream);
+			}
+		}
