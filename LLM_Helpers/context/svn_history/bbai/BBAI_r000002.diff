+bool CvPlayerAI::AI_avoidScience()
+{
+	if (isCurrentResearchRepeat())
+	{
+		return true;
+	}
+
+	if (isNoResearchAvailable())
+	{
+		return true;
+	}
+
+	return false;
+}
