+void CvPlayer::write(FDataStreamBase* pStream)
+{
+	int iI;
+
+	uint uiFlag = 0;
+	uiFlag |= SAVEDATA_HAS_LEAVE_FOREST_OPTION;
+	uiFlag |= SAVEDATA_TOTAL_LAND_SCORED;
