+inline int coordRange(int iCoord, int iRange, bool bWrap)
+{
+	if (bWrap)
+	{
+		if (iRange != 0)
+		{
+			if (iCoord < 0 )
+			{
+				return (iRange + (iCoord % iRange));
+			}
+			else if (iCoord >= iRange)
+			{
+				return (iCoord % iRange);
+			}
+		}
+	}
+
+	return iCoord;
+}
