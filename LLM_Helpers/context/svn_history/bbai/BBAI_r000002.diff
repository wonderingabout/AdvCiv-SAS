+void CvCityAI::AI_doDraft()
+{
+	PROFILE_FUNC();
+
+	bool bWait;
+
+	FAssert(!isHuman());
+
+	if (canConscript())
+	{
+		if (!AI_isDefended() && AI_isDanger())
+		{
+			bWait = false;
+
+			if (!bWait)
+			{
+				if (getConscriptAngerTimer() > 0)
+				{
+					bWait = true;
+				}
+			}
+
+			if (!bWait)
+			{
+				if (getConscriptPopulation() > (getPopulation() / 4))
+				{
+					bWait = true;
+				}
+			}
+
+			if (!bWait)
+			{
+				conscript();
+			}
+		}
+	}
+}
