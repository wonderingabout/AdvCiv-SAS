+	{
+		return iIndex;
+	}
+
+	for ( int i = 0; i < m_iNumFootstepAudioTypes; i++ )
+	{
+		if ( strTag.CompareNoCase(m_paszFootstepAudioTypes[i]) == 0 )
+		{
+			iIndex = i;
+			break;
+		}
+	}
+
+	return iIndex;
