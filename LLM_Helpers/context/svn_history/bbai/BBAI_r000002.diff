+CvDLLButtonPopup* CvDLLButtonPopup::m_pInst = NULL;
+
+CvDLLButtonPopup& CvDLLButtonPopup::getInstance()
+{
+	if (m_pInst == NULL)
+	{
+		m_pInst = new CvDLLButtonPopup;
+	}
+	return *m_pInst;
+}
+
+void CvDLLButtonPopup::freeInstance()
+{
+	delete m_pInst;
+	m_pInst = NULL;
+}
