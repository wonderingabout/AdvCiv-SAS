+		m_abOptions[i] = GC.getGameOptionInfo((GameOptionTypes)i).getDefault();
+	}
+	for (int i = 0; i < NUM_MPOPTION_TYPES; ++i)
+	{
+		m_abMPOptions[i] = GC.getMPOptionInfo((MultiplayerOptionTypes)i).getDefault();
+	}
+}	
