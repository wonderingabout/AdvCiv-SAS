+		}
+	}
+
+	if (AI_airDefensiveCity())
+	{
+		return;
+	}
+
+	if (canAirDefend())
+	{
+		getGroup()->pushMission(MISSION_AIRPATROL);
+		return;
+	}
+
+	getGroup()->pushMission(MISSION_SKIP);
+	return;
