+#include "CvGameCoreDLL.h"
+#include "CvInfos.h"
+
+//
+// Python interface for info classes (formerly structs)
+// These are simple enough to be exposed directly - no wrappers
+//
+
+void CyInfoPythonInterface3()
+{
