+bool CvTeam::isFreeTrade(TeamTypes eIndex)
+{
+	if (isAtWar(eIndex))
+	{
+		return false;
+	}
+
+	if (!isHasMet(eIndex))
+	{
+		return false;
+	}
+
+	return (isOpenBorders(eIndex) || GC.getGameINLINE().isFreeTrade());
+}
