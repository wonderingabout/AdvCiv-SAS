+bool CvUnit::canEnterTerritory(TeamTypes eTeam, bool bIgnoreRightOfPassage) const
+{
+	if (eTeam == getTeam())
+	{
+		return true;
+	}
+
+	if (eTeam == NO_TEAM)
+	{
+		return true;
+	}
+
+	if (GET_TEAM(getTeam()).isAtWar(eTeam))
+	{
+		return true;
+	}
+
+	if (isRivalTerritory())
+	{
+		return true;
+	}
+
+	if (alwaysInvisible())
+	{
+		return true;
+	}
+
+	if (!bIgnoreRightOfPassage)
+	{
+		if (GET_TEAM(getTeam()).isOpenBorders(eTeam))
+		{
+			return true;
+		}
+	}
+
+	return false;
+}
