+
+int CvCityAI::AI_neededAirDefenders()
+{
+	int iDefenders;
+
+	if (!(GET_TEAM(getTeam()).AI_isWarPossible()))
+	{
+		return 0;
+	}
+
+	iDefenders = 1;
+
+	iDefenders += max(0, ((getPopulation() - 3) / 11));
+
+	if (isCapital() && (GET_PLAYER(getOwnerINLINE()).getNumCities() > 1))
+	{
+		iDefenders++;
+	}
+
+	return iDefenders;
+}
