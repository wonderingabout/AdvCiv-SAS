+// Returns true if a mission was pushed...
+bool CvUnitAI::AI_pickup(UnitAITypes eUnitAI)
+{
+	PROFILE_FUNC();
+
+	CvCity* pCity;
+	CvCity* pLoopCity;
+	CvPlot* pBestPlot;
+	CvPlot* pBestPickupPlot;
+	int iPathTurns;
+	int iValue;
