+
+	PROFILE("CvMap::init");
+	gDLL->logMemState( CvString::format("CvMap::init begin - world size=%s, climate=%s, sealevel=%s, num custom options=%6", 
+		GC.getWorldInfo(GC.getInitCore().getWorldSize()).getDescription(), 
