+void stringToBools(const char* szString, int* iNumBools, bool** ppBools)
+{
+	FAssertMsg(szString, "null string");
+	if (szString)
+	{
+		*iNumBools = strlen(szString);
+		*ppBools = new bool[*iNumBools];
+		int i;
+		for(i=0;i<*iNumBools;i++)
+		{
+			(*ppBools)[i] = (szString[i]=='1');
+		}
+	}
+}
