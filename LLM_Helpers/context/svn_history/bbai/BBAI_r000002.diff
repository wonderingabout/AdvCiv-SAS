+		if (canLoadUnit(pLoopUnit, pLoopUnit->plot()))
+		{
+			iValue = 10;
+
+			if (!(pLoopUnit->plot()->isCity()))
+			{
+				iValue += 20;
+			}
+
+			if (pLoopUnit->plot()->isOwned())
+			{
+				if (atWar(getTeam(), pLoopUnit->plot()->getTeam()))
