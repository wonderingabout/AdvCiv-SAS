+									}
+								}
+							}
+						}
+						else
+						{
+							bValid = true;
+						}
+
+						if (bValid)
+						{
+							if (!(pLoopPlot->isVisibleEnemyUnit(getOwnerINLINE())))
+							{
+								if (GET_PLAYER(getOwnerINLINE()).AI_plotTargetMissionAIs(pLoopPlot, MISSIONAI_BUILD, getGroup(), 1) == 0)
+								{
