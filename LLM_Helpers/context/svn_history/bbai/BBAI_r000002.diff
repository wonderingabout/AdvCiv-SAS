+void CvGame::verifyDeals()
+{
+	CvDeal* pLoopDeal;
+	int iLoop;
+
+	for(pLoopDeal = firstDeal(&iLoop); pLoopDeal != NULL; pLoopDeal = nextDeal(&iLoop))
+	{
+		pLoopDeal->verify();
+	}
+}
