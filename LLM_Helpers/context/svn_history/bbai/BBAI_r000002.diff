+OrderData* CvCity::getOrderFromQueue(int iIndex)
+{
+	CLLNode<OrderData>* pOrderNode;
+
+	pOrderNode = m_orderQueue.nodeNum(iIndex);
+
+	if (pOrderNode != NULL)
+	{
+		return &(pOrderNode->m_data);
+	}
