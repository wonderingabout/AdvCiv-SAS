+	}
+	if (bLoaded && Validate())
+	{
+		SetGlobalClassInfo(&GC.getQuestInfo(), "Civ4QuestInfos/QuestInfo", &GC.getNumQuestInfos());
+	}
+
+	// load the new FXml variable with the Civ4TutorialInfos.xml file
+	bLoaded = LoadCivXml(m_pFXml, "Misc/Civ4TutorialInfos.xml");
