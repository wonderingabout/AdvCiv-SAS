+
+	CvUnit* pLoopUnit;
+	CvUnit* pBestUnit;
+	int iValue;
+	int iBestValue;
+	int iLoop;
+
+	if (getCargo() > 0)
+	{
+		return false;
+	}
+
+	if (isCargo())
+	{
+		if (canAirDefend())
+		{
+			getGroup()->pushMission(MISSION_AIRPATROL);
