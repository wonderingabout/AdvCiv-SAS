+
+	iAnger = 0;
+
+	iOvercrowding = (getPopulation() + iExtra);
+
+	if (iOvercrowding > 0)
+	{
+		iAnger += (((iOvercrowding * GC.getDefineINT("PERCENT_ANGER_DIVISOR")) / max(1, (getPopulation() + iExtra))) + 1);
+	}
+
+	return iAnger;
