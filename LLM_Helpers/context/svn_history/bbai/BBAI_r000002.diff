+	{
+		return false;
+	}
+
+	int j=0;				//loop counter
+	int k=0;				//loop counter
+	int iNumSibs=0;				// the number of siblings the current xml node has
+	int iIndexVal;
+
+	pXML->GetChildXmlValByName(szTextVal, "Class");
