+	FAssertMsg(*pppfList == NULL,"memory leak?");
+	FAssertMsg(((0 < iSizeX) && (0 < iSizeY)), "list size to allocate is less than 1");
+	// allocate the memory for the array of pointers to arrays of floats
+	*pppfList = new float *[iSizeX];
