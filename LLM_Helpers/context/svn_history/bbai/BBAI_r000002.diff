+	pStream->Read(&m_iDefensivePactTradingCount);
+	pStream->Read(&m_iPermanentAllianceTradingCount);
+	pStream->Read(&m_iBridgeBuildingCount);
+	pStream->Read(&m_iIrrigationCount);
+	pStream->Read(&m_iIgnoreIrrigationCount);
