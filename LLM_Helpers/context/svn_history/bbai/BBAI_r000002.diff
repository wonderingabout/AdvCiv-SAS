+CvPopupInfo::CvPopupInfo(ButtonPopupTypes eButtonPopupType, int iData1, int iData2, int iData3, int iFlags, bool bOption1, bool bOption2) :
+	m_iData1(iData1),
+	m_iData2(iData2),
+	m_iData3(iData3),
+	m_iFlags(iFlags),
+	m_bOption1(bOption1),
