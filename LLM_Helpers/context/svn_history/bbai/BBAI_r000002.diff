+	else
+	{
+		eImprovement = getImprovementType();
+	}
+
+	if (eImprovement != NO_IMPROVEMENT)
+	{
+		iModifier += GC.getImprovementInfo(eImprovement).getDefenseModifier();
+	}
+
+	if (!bHelp)
+	{
+		pCity = getPlotCity();
+
+		if (pCity != NULL)
+		{
+			iModifier += pCity->getDefenseModifier(bIgnoreBuilding);
