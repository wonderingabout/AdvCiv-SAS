+{
+	if (bLate && !isEmpty(getLateArtDefineTag(i)))
+	{
+		return ARTFILEMGR.getUnitArtInfo( getLateArtDefineTag(i));
+	}
+	else
+	{
+		return ARTFILEMGR.getUnitArtInfo( getEarlyArtDefineTag(i));
+	}
