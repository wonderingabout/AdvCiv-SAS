+
+	if ( checkBounds(eOldID, 0, MAX_CIV_PLAYERS) && checkBounds(eNewID, 0, MAX_CIV_PLAYERS) )
+	{
+		// *** SAVE TARGET SLOT DETAILS TEMPORARILY
+		// Temp civ details
