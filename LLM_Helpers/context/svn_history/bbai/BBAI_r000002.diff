+
+ImprovementTypes CvPlot::getRevealedImprovementType(TeamTypes eTeam, bool bDebug) const
+{
+	if (bDebug && GC.getGameINLINE().isDebugMode())
+	{
+		return getImprovementType();
+	}
+	else
