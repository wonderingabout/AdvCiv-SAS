+
+CLLNode<MissionData>* CvSelectionGroup::headMissionQueueNode() const
+{
+	return m_missionQueue.head();
+}
+
+
+CLLNode<MissionData>* CvSelectionGroup::tailMissionQueueNode() const
+{
+	return m_missionQueue.tail();
+}
