+void CvPlot::updatePlotGroup()
+{
+	int iI;
+
+	for (iI = 0; iI < MAX_PLAYERS; iI++)
+	{
+		if (GET_PLAYER((PlayerTypes)iI).isAlive())
+		{
+			updatePlotGroup((PlayerTypes)iI);
+		}
+	}
