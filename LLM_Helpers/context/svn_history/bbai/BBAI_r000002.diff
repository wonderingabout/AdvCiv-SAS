+	else if ((eOrder == ORDER_TRAIN) && (pCity->getProductionUnit() == iData))
+	{
+		gDLL->sendPushOrder(pCity->getID(), eOrder, iData, bAlt, !bCtrl, bCtrl);
+	}
+	else
+	{
+		gDLL->sendPushOrder(pCity->getID(), eOrder, iData, bAlt, bShift, bCtrl);
+	}
