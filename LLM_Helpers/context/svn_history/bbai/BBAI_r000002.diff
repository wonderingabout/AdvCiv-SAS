+bool CvUnit::canAirlift(const CvPlot* pPlot) const
+{
+	CvCity* pCity;
+
+	if (getDomainType() != DOMAIN_LAND)
+	{
+		return false;
+	}
+
+	if (hasMoved())
+	{
+		return false;
+	}
+
+	pCity = pPlot->getPlotCity();
+
+	if (pCity == NULL)
+	{
+		return false;
+	}
+
+	if (pCity->getCurrAirlift() >= pCity->getMaxAirlift())
+	{
+		return false;
+	}
+
+	if (pCity->getTeam() != getTeam())
+	{
+		return false;
+	}
+
+	return true;
+}
