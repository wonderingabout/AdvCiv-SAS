+	pXML->GetChildXmlValByName(&m_iNumCultureCities, "iNumCultureCities");
+	pXML->GetChildXmlValByName(&m_iTotalCultureRatio, "iTotalCultureRatio");
+	pXML->GetChildXmlValByName(m_szMovie, "VictoryMovie");
+	
+	return true;
+}
