+// Returns true if a mission was pushed...
+bool CvUnitAI::AI_afterAttack()
+{
+	if (!isMadeAttack())
+	{
+		return false;
+	}
+
+	if (isBlitz())
+	{
+		return false;
+	}
+
+	if (getDomainType() == DOMAIN_LAND)
+	{
+		if (AI_guardCity(false, true, 1))
+		{
+			return true;
+		}
+	}
+
+	if (AI_pillageRange(1))
+	{
+		return true;
+	}
+
+	if (AI_retreatToCity(false, false, 1))
+	{
+		return true;
+	}
+
+	if (AI_hide())
+	{
+		return true;
+	}
+
+	if (AI_goody(1))
+	{
+		return true;
+	}
+
+	if (AI_pillageRange(2))
+	{
+		return true;
+	}
+
+	if (AI_defend())
+	{
+		return true;
+	}
+
+	if (AI_safety())
+	{
+		return true;
+	}
+
+	return false;
+}
