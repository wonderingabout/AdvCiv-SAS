+int CvCity::getCurrentProductionDifference(bool bIgnoreFood, bool bOverflow)
+{
+	return getProductionDifference(getProductionNeeded(), getProduction(), getProductionModifier(), (!bIgnoreFood && isFoodProduction()), bOverflow);
+}
