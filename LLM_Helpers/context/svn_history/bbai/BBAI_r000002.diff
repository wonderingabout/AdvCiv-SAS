+
+void CvCity::stopHeadOrder()
+{
+	CLLNode<OrderData>* pOrderNode;
+
+	pOrderNode = headOrderQueueNode();
+
+	if (pOrderNode != NULL)
+	{
+		if (pOrderNode->m_data.eOrderType == ORDER_MAINTAIN)
+		{
+			processProcess(((ProcessTypes)(pOrderNode->m_data.iData1)), -1);
+		}
+	}
+}
