+				if (isHasMet((TeamTypes)iI))
+				{
+					if (AI_getAttitude((TeamTypes)iI) < ATTITUDE_CAUTIOUS)
+					{
+						iValue = AI_getAttitudeVal((TeamTypes)iI);
+
+						if (iValue < iBestValue)
+						{
+							iBestValue = iValue;
+							eBestTeam = ((TeamTypes)iI);
+						}
+					}
+				}
+			}
+		}
+	}
+
+	m_eWorstEnemy = eBestTeam;
+}
