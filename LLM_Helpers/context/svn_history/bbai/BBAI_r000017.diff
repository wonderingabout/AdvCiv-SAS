+
+int CvCityAI::AI_getHappyFromHurry(int iHurryPopulation)
+{
+	int iHappyDiff = iHurryPopulation - GC.getDefineINT("HURRY_POP_ANGER");
+	if (iHappyDiff > 0)
+	{
+		if (getHurryAngerTimer() <= 1)
+		{
+			if (2 * angryPopulation(1) - healthRate(false, 1) > 1)
+			{
+				return iHappyDiff;
+			}
+		}
+	}
+
+	return 0;
+}
