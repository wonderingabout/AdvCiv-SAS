+void CvUnitAI::UDgetBetterAttacker(CvUnit** ppAttacker, const CvPlot* pPlot, bool bPotentialEnemy, int& iAIAttackOdds, int& iAttackerValue) const
+{
+	CvUnit* pThis = (CvUnit*)this;
