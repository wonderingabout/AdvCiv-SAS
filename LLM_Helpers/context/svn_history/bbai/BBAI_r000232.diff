+	int iStuffValue = 0;
+	
+	int iProductionValue = 0;
+	int iCommerceValue = 0;
+	int iFoodValue = 0;
+	
+	if (bFoodIsProduction)
+	{
+		// if food is production, the count it
+		iProductionValue += aiYields[YIELD_FOOD] * 55;
+	}
+	else
+	{
+	
+		iFoodValue += 100 * aiYields[YIELD_FOOD];
+	}
+	
+	iProductionValue += aiYields[YIELD_PRODUCTION] * 55;
+	
+	for (iI = 0; iI < NUM_COMMERCE_TYPES; iI++)
+	{
+		iCommerceValue += ((aiCommerceYields[iI] * 40) * GET_PLAYER(getOwnerINLINE()).AI_averageCommerceExchange((CommerceTypes)iI)) / 100;
