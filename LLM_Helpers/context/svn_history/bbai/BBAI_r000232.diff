+int CvCityAI::AI_unifiedYieldValue(short* piYields, short* piCommerce, bool bAvoidGrowth, bool bRemove, bool bIgnoreFood, bool bIgnoreGrowth)
+{
+	PROFILE_FUNC();
+
+	int aiYields[NUM_YIELD_TYPES];
+	int aiCommerceYields[NUM_COMMERCE_TYPES];
+	int iNewCityYield;
+	int iOldCityYield;
+	int iValue;
+	int iI, iJ;
