+// value of a plot for fogbusting
+int CvUnitAI::AI_fogbustPlotValue(const CvPlot* pPlot, int iObserverChange) const
+{
+	int iValue = 0;
+	
+	int iNewVisibilityCount = pPlot->getVisibilityCount(GET_PLAYER(getOwnerINLINE()).getTeam()) + iObserverChange;
+	if (iNewVisibilityCount == 1)
+	{
+		iValue ++;
+
+		if (!pPlot->isOwned())
+		{
+			iValue ++;
+		}
+
+		if (!pPlot->isImpassable())
+		{
+			iValue *= 4;
+
+			if ((getDomainType() == DOMAIN_SEA) || pPlot->getArea() == getArea())
+			{
+				iValue *= 2;
+			}
+		}
+	}
+	
+	return iValue;
+}
+
+// determines the change in fogbusting plot values by moving to new plot
+void CvUnitAI::AI_fogbustPlotDifference(CvPlot* pNewPlot, CLinkList<CvPlot*>& visiblePlotList, int& iFogbustingPlotsWeLose, int& iFogbustingPlotsWeGain)
+{
+	TeamTypes eTeam = GET_PLAYER(getOwnerINLINE()).getTeam();
+
+	int iRange = visibilityRange();
+	bool bSeaUnit = (getDomainType() == DOMAIN_SEA);
+
+	// copy full visible list, will remove all the plots that intersect later
+	CLinkList<CvPlot*> noLongerVisibleList;
+	for (CLLNode<CvPlot*>* pNode = visiblePlotList.head(); (pNode != NULL); pNode = visiblePlotList.next(pNode))
+	{
+		noLongerVisibleList.insertAtEnd(pNode->m_data);
+	}
+	
+	// get list of visible plots at new location, and remove overlap plots from no longer visible list
+	CLinkList<CvPlot*> newVisiblePlotList; 
+	pNewPlot->getVisiblePlotsList(newVisiblePlotList, eTeam, iRange, &noLongerVisibleList, /*bXOrExcludeList*/ true);
+
+	// count visible plots we lose
+	iFogbustingPlotsWeLose = 0;
+	for (CLLNode<CvPlot*>* pNode = noLongerVisibleList.head(); (pNode != NULL); pNode = noLongerVisibleList.next(pNode))
+	{
+		iFogbustingPlotsWeLose += AI_fogbustPlotValue(pNode->m_data);
+	}
+
+	// count visible plots we gain
+	iFogbustingPlotsWeGain = 0;
+	for (CLLNode<CvPlot*>* pNode = newVisiblePlotList.head(); (pNode != NULL); pNode = newVisiblePlotList.next(pNode))
+	{
+		iFogbustingPlotsWeGain += AI_fogbustPlotValue(pNode->m_data, /*iObserverChange*/ +1);
+	}
+}
