+// Returns true if a mission was pushed...
+bool CvUnitAI::AI_fogbust()
+{
+	PROFILE_FUNC();
+
+	int iBestValue = 0;
+	CvPlot* pBestPlot = NULL;
+	CvPlot* pBestFogbustPlot = NULL;
+
+	PlayerTypes ePlayer = getOwnerINLINE();
+	CvPlayerAI& kPlayer = GET_PLAYER(ePlayer);
+	TeamTypes eTeam = kPlayer.getTeam();
+	
+	int iRange = visibilityRange();
+	bool bSeaUnit = (getDomainType() == DOMAIN_SEA);
+
+	// are we already busting fog? check all the plots visible to us
+	int iOurTerritoryCount = 0;
+	int iPlotsWeFogbusting = 0;
+	int iEnemyPlots = 0;
+	CLinkList<CvPlot*> visiblePlotList;
+	plot()->getVisiblePlotsList(visiblePlotList, eTeam, iRange);
+	for (CLLNode<CvPlot*>* pNode = visiblePlotList.head(); (pNode != NULL); pNode = visiblePlotList.next(pNode))
+	{
+		CvPlot* pLoopPlot = pNode->m_data;
+
+		iPlotsWeFogbusting += AI_fogbustPlotValue(pLoopPlot);
+
+		if (pLoopPlot->getArea() == getArea() && pLoopPlot->isVisibleEnemyUnit(ePlayer))
+		{
+			iEnemyPlots++;
+		}
+
+		if (pLoopPlot->getOwnerINLINE() == ePlayer)
+		{
+			iOurTerritoryCount++;
+		}
+	}
+
+	// count the plots just outside our visibility that we own as well
+	CLinkList<CvPlot*> furtherPlotList;
+	plot()->getVisiblePlotsList(furtherPlotList, eTeam, iRange + 1, &visiblePlotList);
+	for (CLLNode<CvPlot*>* pNode = visiblePlotList.head(); (pNode != NULL); pNode = visiblePlotList.next(pNode))
+	{
+		CvPlot* pLoopPlot = pNode->m_data;
+
+		if (pLoopPlot->getOwnerINLINE() == ePlayer)
+		{
+			iOurTerritoryCount++;
+		}
+	}
+
+	bool bOurTerritoryInRange = (iOurTerritoryCount > 0);
+
+	// if still cannot find any plots owned by us, see if we can path through visible plots to our territory
+	//CvCity* pPathCity = NULL;
+	//if (!bOurTerritoryInRange && iPlotsWeFogbusting > 0)
+	//{
+	//	// search cities on this area for fog to bust
+	//	int iLoop;
+	//	for (CvCity* pLoopCity = kPlayer.firstCity(&iLoop); !bOurTerritoryInRange && pLoopCity != NULL; pLoopCity = kPlayer.nextCity(&iLoop))
+	//	{
+	//		if (pLoopCity->getArea() == getArea())
+	//		{
+	//			if (generatePath(pLoopCity->plot(), 0, true))
+	//			{
+	//				// walk the path, checking to make sure each plot is visible by us
+	//				bool bPathVisible = true;
+	//				FAStarNode* pNode = getPathLastNode();
+	//				while (pNode != NULL && bPathVisible)
+	//				{
+	//					CvPlot* pPathPlot = GC.getMapINLINE().plotSorenINLINE(pNode->m_iX, pNode->m_iY);
+	//					
+	//					if (pPathPlot->getVisibilityCount(eTeam) <= 0)
+	//					{
+	//						bPathVisible = false;
+	//					}
+
+	//					pNode = pNode->m_pParent;
+	//				}
+
+	//				if (bPathVisible)
+	//				{
+	//					bOurTerritoryInRange = true;
+	//					pPathCity = pLoopCity;
+	//				}
+	//			}
+	//		}
+	//	}
+	//}
+
+
+	// if we are fogbusting some plots or enemy nearby, check adjacent plots for even better fogbusting
+	if (iPlotsWeFogbusting > 0 || iEnemyPlots > 0)
+	{
+		// if we cannot find a better plot, stay in place rather than searching other cities
+		if ((bOurTerritoryInRange && iPlotsWeFogbusting > 0) || iEnemyPlots > 0)
+		{
+			pBestFogbustPlot = pBestPlot = plot();
+		}
+		
+		// if there are enemies about, we will choose the best defensive plot
+		int iCurrCombatStr = 0;				
+		if (iEnemyPlots > 0)
+		{
+			FAssert(pBestPlot != NULL);
+			iCurrCombatStr = currCombatStr(pBestPlot, NULL);
+		}
+
+		// get full further list, will remove all the plots that intersect later
+		CLinkList<CvPlot*> furtherAndVisiblePlotList;
+		plot()->getVisiblePlotsList(furtherAndVisiblePlotList, eTeam, iRange + 1);
+
+		for (int iI = 0; iI < NUM_DIRECTION_TYPES; iI++)
+		{
+			// check non-impassable adjacent plots that do not have enemies in them
+			CvPlot* pAdjacentPlot = plotDirection(getX_INLINE(), getY_INLINE(), (DirectionTypes) iI);
+			if (pAdjacentPlot != NULL && !pAdjacentPlot->isImpassable() && !pAdjacentPlot->isVisibleEnemyUnit(ePlayer))
+			{
+				// count up fogbusting plots we lose and gain
+				int iFogbustingPlotsWeLose = 0;
+				int iFogbustingPlotsWeGain = 0;
+				AI_fogbustPlotDifference(pAdjacentPlot, visiblePlotList, iFogbustingPlotsWeLose, iFogbustingPlotsWeGain);
+
+				// copy full further list, will remove all the plots that intersect later
+				CLinkList<CvPlot*> lostFurtherPlotList;
+				for (CLLNode<CvPlot*>* pNode = furtherAndVisiblePlotList.head(); (pNode != NULL); pNode = furtherAndVisiblePlotList.next(pNode))
+				{
+					lostFurtherPlotList.insertAtEnd(pNode->m_data);
+				}
+				
+				// get list of visible plots at new location, and remove overlap plots from lost further list
+				CLinkList<CvPlot*> newFurtherPlotList; 
+				pAdjacentPlot->getVisiblePlotsList(newFurtherPlotList, eTeam, iRange + 1, &lostFurtherPlotList, /*bXOrExcludeList*/ true);
+
+				// count our owned plots we lost
+				int iOurTerritoryCountLost = 0;
+				for (CLLNode<CvPlot*>* pNode = lostFurtherPlotList.head(); (pNode != NULL); pNode = lostFurtherPlotList.next(pNode))
+				{
+					CvPlot* pLoopPlot = pNode->m_data;
+					if (pLoopPlot->getOwnerINLINE() == ePlayer)
+					{
+						iOurTerritoryCountLost++;
+					}
+				}
+
+				// count our owned plots we gain
+				int iOurTerritoryCountGain = 0;
+				for (CLLNode<CvPlot*>* pNode = newFurtherPlotList.head(); (pNode != NULL); pNode = newFurtherPlotList.next(pNode))
+				{
+					CvPlot* pLoopPlot = pNode->m_data;
+					if (pLoopPlot->getOwnerINLINE() == ePlayer)
+					{
+						iOurTerritoryCountGain++;
+					}
+				}
+
+				// if the new plot is in range of our territory
+				int iNewOurTerritoryCount = iOurTerritoryCount - iOurTerritoryCountLost + iOurTerritoryCountGain;
+				bool bNewOurTerritoryInRange = (iNewOurTerritoryCount > 0);
+
+				// is this new plot in range of our territory? (or enemy present)
+				if (bNewOurTerritoryInRange || (iEnemyPlots > 0))
+				{
+					int iFogbustingChange = iFogbustingPlotsWeGain - iFogbustingPlotsWeLose;
+					int iValue = iPlotsWeFogbusting + iFogbustingChange;
+
+					// if start not in range and we fogbust at all, or we gain at least one plot (or there are enemies about), 
+					// consider this as our best choice
+					if ((!bOurTerritoryInRange && iValue > 0) || iFogbustingChange > 0 || iEnemyPlots > 0)
+					{
+						if (canMoveInto(pAdjacentPlot, /*bAttack*/ false, /*bDeclareWar*/ false, /*bIgnoreLoad*/ true))
+						{
+							// if there is an enemy in our fogbusting area, move to the best defensive bonus
+							if (iEnemyPlots > 0)
+							{
+								int iAdjacentPlotCombatStr = currCombatStr(pAdjacentPlot, NULL);
+								int iCombatDifference = iAdjacentPlotCombatStr - iCurrCombatStr;
+
+								// if adjacent plot is better defensively (not checking for fogbusting in this case)
+								// or equal and we gain significant fogbusting ability
+								if ((iCombatDifference > 0) || 
+									(iCombatDifference == 0 && (iFogbustingChange > 2 || (iValue > 0 && iPlotsWeFogbusting == 0))))
+								{
+									iValue += (3 * iCombatDifference);
+								}
+								// adjacent plot is worse defensively, reject it
+								else
+								{
+									iValue = 0;
+								}
+							}
+
+							// if better, or equal and random chance choose this one
+							if (iValue > iBestValue || (iValue > 0 && iValue == iBestValue && GC.getGameINLINE().getSorenRandNum(2, "AI fogbust")))
+							{
+								iBestValue = iValue;
+								pBestFogbustPlot = pBestPlot = pAdjacentPlot;
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+	
+	// if there was nothing good nearby
+	if (pBestPlot == NULL)
+	{
+		// search cities on this area for fog to bust
+		int iLoop;
+		for (CvCity* pLoopCity = kPlayer.firstCity(&iLoop); pLoopCity != NULL; pLoopCity = kPlayer.nextCity(&iLoop))
+		{
+			if (bSeaUnit || pLoopCity->getArea() == getArea())
+			{
+				// for each city, test all 8 sides to see if there is a good fogbusting spot
+				for (int iI = 0; iI < NUM_DIRECTION_TYPES; iI++)
+				{
+					int iDistanceToGo = pLoopCity->getCultureLevel() + iRange + 1;
+					
+					// move up to iDistanceToGo from center, if possible
+					CvPlot* pPreviousCheckPlot = NULL;
+					CvPlot* pCheckPlot = NULL;
+					CvPlot* pNextPlot = pLoopCity->plot();
+					while (0 < iDistanceToGo-- &&
+						(pNextPlot = plotDirection(pNextPlot->getX_INLINE(), pNextPlot->getY_INLINE(), (DirectionTypes) iI)) != NULL)
+					{
+						// remember the last plot (only on our area for land units)
+						if (bSeaUnit || (pCheckPlot != NULL && pCheckPlot->getArea() == getArea()))
+						{
+							pPreviousCheckPlot = pCheckPlot;
+						}
+
+						pCheckPlot = pNextPlot;
+					}
+					
+					// try to find good plot (trying previous, left and right, double left and double right plots)
+					for (int iPass = 0; iPass <= 5; iPass++)
+					{
+						// if non-sea unit and wrong area, or cannot move into
+						if (pCheckPlot != NULL && ((!bSeaUnit && pCheckPlot->getArea() != getArea()) || 
+							!canMoveInto(pCheckPlot, /*bAttack*/ false, /*bDeclareWar*/ false, /*bIgnoreLoad*/ true)))
+						{
+							pCheckPlot = NULL;
+						}
+
+						// if good plot, we do not need to try any more
+						if (pCheckPlot != NULL && !pCheckPlot->isVisibleEnemyUnit(ePlayer))
+						{
+							break;
+						}
+						// if bad plot, try another
+						else
+						{
+							switch (iPass)
+							{
+							// first try the previous plot
+							case 0:
+								pCheckPlot = pPreviousCheckPlot;
+								break;
+							
+							// next try the left plot
+							case 1:
+								pPreviousCheckPlot = (pPreviousCheckPlot != NULL) ? pPreviousCheckPlot : pCheckPlot;
+								if (pPreviousCheckPlot != NULL)
+								{
+									pCheckPlot = plotDirection(pPreviousCheckPlot->getX_INLINE(), pPreviousCheckPlot->getY_INLINE(), GC.getTurnLeftDirection(iI));
+								}
+								break;
+
+							// next try the right plot
+							case 2:
+								if (pPreviousCheckPlot != NULL)
+								{
+									pCheckPlot = plotDirection(pPreviousCheckPlot->getX_INLINE(), pPreviousCheckPlot->getY_INLINE(), GC.getTurnRightDirection(iI));
+								}
+								break;
+
+							// next try the double left plot
+							case 3:
+								if (pPreviousCheckPlot != NULL)
+								{
+									CvPlot* pStepOnePlot = plotDirection(pPreviousCheckPlot->getX_INLINE(), pPreviousCheckPlot->getY_INLINE(), GC.getTurnLeftDirection(iI));
+									if (pStepOnePlot != NULL)
+									{
+										pCheckPlot = plotDirection(pStepOnePlot->getX_INLINE(), pStepOnePlot->getY_INLINE(), GC.getTurnLeftDirection(GC.getTurnLeftDirection(iI)));
+									}
+								}
+								break;
+
+							// next try the double right plot
+							case 4:
+								if (pPreviousCheckPlot != NULL)
+								{
+									CvPlot* pStepOnePlot = plotDirection(pPreviousCheckPlot->getX_INLINE(), pPreviousCheckPlot->getY_INLINE(), GC.getTurnRightDirection(iI));
+									if (pStepOnePlot != NULL)
+									{
+										pCheckPlot = plotDirection(pStepOnePlot->getX_INLINE(), pStepOnePlot->getY_INLINE(), GC.getTurnRightDirection(GC.getTurnRightDirection(iI)));
+									}
+								}
+								break;
+
+							// thats it, nothing found
+							case 5:
+								pCheckPlot = NULL;
+							}
+						}
+					}
+
+					// if we found a good plot
+					if (pCheckPlot != NULL)
+					{
+						// count up fogbusting plots we lose and gain
+						int iFogbustingPlotsWeLose = 0;
+						int iFogbustingPlotsWeGain = 0;
+						AI_fogbustPlotDifference(pCheckPlot, visiblePlotList, iFogbustingPlotsWeLose, iFogbustingPlotsWeGain);
+
+						// are any other units headed to the area?
+						int iMissionCount = kPlayer.AI_plotTargetMissionAIs(pCheckPlot, MISSIONAI_EXPLORE, getGroup(), iRange + 1);
+						//if (iMissionCount > 0)
+						//{
+						//	// if any units are headed to exactly the same plot, that counts way more
+						//	iMissionCount = 8 * kPlayer.AI_plotTargetMissionAIs(pCheckPlot, MISSIONAI_EXPLORE, getGroup(), 0);
+						//}
+
+						// if at least one plot, consider this as our best choice
+						int iValue = iPlotsWeFogbusting + iFogbustingPlotsWeGain - iFogbustingPlotsWeLose;
+						if (iValue > 0)
+						{
+							int iPathTurns = 0;
+							if (atPlot(pCheckPlot) || generatePath(pCheckPlot, 0, true, &iPathTurns))
+							{
+								iValue = (iValue * 128) / (8 + iPathTurns);
+								iValue /= ((8 * iMissionCount) + 1);
+								iValue = (iValue > 0) ? iValue : 1;
+								
+								// if better, or equal and random chance choose this one
+								if (iValue > iBestValue || (iValue > 0 && iValue == iBestValue && GC.getGameINLINE().getSorenRandNum(2, "AI fogbust")))
+								{
+									iBestValue = iValue;
+									pBestFogbustPlot = pCheckPlot;
+									pBestPlot = getPathEndTurnPlot();
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+
+	if (pBestPlot != NULL)
+	{
+		if (atPlot(pBestPlot))
+		{
+			getGroup()->pushMission(MISSION_SKIP, 0, 0, 0, false, false, MISSIONAI_EXPLORE, pBestPlot);
+			return true;
+		}
+		else
+		{
+			FAssert(!atPlot(pBestPlot));
+			getGroup()->pushMission(MISSION_MOVE_TO, pBestPlot->getX_INLINE(), pBestPlot->getY_INLINE(), MOVE_NO_ENEMY_TERRITORY, false, false, MISSIONAI_EXPLORE, pBestFogbustPlot);
+			return true;
+		}
+	}
+
+	return false;
+}
 
