+// Returns ratio of strengths of stacks times 100 
+// (so 100 is even ratio, numbers over 100 mean this group is more powerful than the stack on a plot)
+int CvSelectionGroupAI::AI_compareStacks(const CvPlot* pPlot, bool bPotentialEnemy) const
+{
+	FAssert(getOwnerINLINE() != NO_PLAYER);
+	FAssert(pPlot != NULL);
+	
+	int	compareRatio;
+	DomainTypes eDomainType = NO_DOMAIN;
+
+	compareRatio = AI_sumStrength(pPlot, eDomainType, false);
+	compareRatio *= 100;
+
+	compareRatio /= pPlot->AI_sumStrength(NO_PLAYER, getOwnerINLINE(), eDomainType, !bPotentialEnemy, bPotentialEnemy);
+
+	return compareRatio;
+}
+
+int CvSelectionGroupAI::AI_sumStrength(const CvPlot* pAttackedPlot, DomainTypes eDomainType, bool bCheckCanAttack) const
+// may want to add check on canMove and/or canMoveInto to AI_sumStrength (would add bool)
+{
+	CLLNode<IDInfo>* pUnitNode;
+	CvUnit* pLoopUnit;
+	int	strSum = 0;
+
+	pUnitNode = headUnitNode();
+
+	while (pUnitNode != NULL)
+	{
+		pLoopUnit = ::getUnit(pUnitNode->m_data);
+		pUnitNode = nextUnitNode(pUnitNode);
+
+		if (!pLoopUnit->isDead())
+		{
+			bool bCanAttack = false;
+			if (pLoopUnit->getDomainType() == DOMAIN_AIR)
+				bCanAttack = pLoopUnit->canAirAttack();
+			else
+				bCanAttack = pLoopUnit->canAttack();
+
+			if (!bCheckCanAttack || bCanAttack)
+			{
+				if (eDomainType == NO_DOMAIN || pLoopUnit->getDomainType() == eDomainType)
+					strSum += pLoopUnit->currEffectiveStr(pAttackedPlot, pLoopUnit);
+			}
+		}
+	}
+
+	return strSum;
 }
 
 

