+class CvVisibilityRegion : public std::map<XYCoords, int>
+{
+public:	
+	// adding adds the int values at each plot, building a union of the two regions
+	void operator+= (const CvVisibilityRegion& regionToAdd)
+	{ 
+		for(CvVisibilityRegion::const_iterator it = regionToAdd.begin(); it != regionToAdd.end(); it++)
+		{
+			// add the value, creating the entry if it doesnt exist
+			(*this)[(*it).first] += (*it).second;
+		}
+	}
+	
+	// subtract finds the _positive_ intersection of the regions, 
+	// if a point from regionToSubtract is in this region, then subtract the value from the other set 
+	// if the result value is not positive, then remove this point from this set
+	void operator-= (const CvVisibilityRegion& regionToSubtract)
+	{ 
+		for(CvVisibilityRegion::const_iterator it = regionToSubtract.begin(); it != regionToSubtract.end(); it++)
+		{
+			const XYCoords& xy = (*it).first;
+			// make sure we have this plot in the set
+			CvVisibilityRegion::iterator itFind = this->find(xy);
+			if (itFind != this->end())
+			{
+				// subtract
+				int iNewValue = (*itFind).second - (*it).second;
+				if (iNewValue > 0)
+				{
+					(*itFind).second = iNewValue;
+				}
+				else
+				{
+					this->erase(itFind);
+				}
+			}
+		}
+	}
+	
+	// copy the left hand operand into new region, then += that with the right hand operand and return the result
+	CvVisibilityRegion operator+ (const CvVisibilityRegion& regionToAdd) const 
+	{
+		CvVisibilityRegion resultRegion(*this);
+		resultRegion += regionToAdd;
+		return resultRegion;
+	}
+
+};
+
