+void CvPlot::buildVisibilityRegion(CvVisibilityRegion& visiblePlots, CLLNode<IDInfo>* pHeadNode, TeamTypes eTeam) const
+{
+	int iLastRange = MAX_INT;
+	
+	// only call addPlotVisiblity once for each range, starting at highest range
+	while (iLastRange >= 0)
+	{
+		int iNextRange = -1;
+		int iNextObserverCount = 0;
+
+		CLLNode<IDInfo>* pUnitNode = pHeadNode;
+		while (pUnitNode !=	NULL)
+		{
+			CvUnit*	pLoopUnit =	::getUnit(pUnitNode->m_data);
+			pUnitNode =	nextUnitNode(pUnitNode);
+			
+			if (pLoopUnit->getTeam() == eTeam)
+			{
+				int iUnitRange = pLoopUnit->visibilityRange();
+
+				// is the range in bounds to consider this pass?
+				if (iUnitRange >= 0 && iUnitRange < iLastRange)
+				{
+					// is this range the highest valid one?
+					if (iUnitRange > iNextRange)
+					{
+						iNextRange = iUnitRange;
+						iNextObserverCount = 1;
+					}
+					// otherwise, is it equal?
+					else if (iUnitRange == iNextRange)
+					{
+						iNextObserverCount++;
+					}
+				}
+			}
+		}
+
+		// do we have more to add?
+		if (iNextObserverCount > 0)
+		{
+			FAssert(iNextRange >= 0);
+			addPlotVisiblity(visiblePlots, iNextRange, iNextObserverCount, eTeam);
+		}
+
+		// set last range
+		iLastRange = iNextRange;
+	}
+}
