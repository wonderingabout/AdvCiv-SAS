+OrderData CvCity::getOrderData(int iIndex) const
+{
+	int iCount = 0;
+	CLLNode<OrderData>* pNode = headOrderQueueNode();
+	while (pNode != NULL)
+	{
+		if (iIndex == iCount)
+		{
+			return pNode->m_data;
+		}
+		iCount++;
+		pNode = nextOrderQueueNode(pNode);
+	}
+	OrderData kData;
+	kData.eOrderType = NO_ORDER;
+	kData.iData1 = -1;
+	kData.iData2 = -1;
+	kData.bSave = false;
+	return kData;
 }
 
