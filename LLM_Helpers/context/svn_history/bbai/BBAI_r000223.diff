+int CvPlayerAI::AI_averageGreatPeopleMultiplier()
+{
+	if (m_iAveragesCacheTurn != GC.getGameINLINE().getGameTurn())
+	{
+		AI_calculateAverages();
+	}
+	return m_iAverageGreatPeopleMultiplier;	
+}
