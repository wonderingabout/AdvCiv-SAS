+	FAssert(eCommerce < NUM_COMMERCE_TYPES);
+	
+	if (m_iAveragesCacheTurn != GC.getGameINLINE().getGameTurn())
+	{
+		AI_calculateAverages();
+	}
+	
+	return m_aiAverageCommerceMultiplier[eCommerce];	
+}
