+				{
+					continue;
+				}
+
+				// add the plot to region (note, this can reset the data value of a CvPlotDataRegion to zero)
+				adjacentRegion.insert(plotRegion.end(), makeXYCoords(plotRegion.end(), xy));
+			}
+		}
+	}
