+bool CvUnitAI::AI_groupMergeRange(UnitAITypes eUnitAI, int iRange, bool bBiggerOnly)
+{
+	PROFILE_FUNC();
+
+	CvUnit* pLoopUnit;
+	CvUnit* pBestUnit;
+	int iPathTurns;
+	int iValue;
+	int iBestValue;
+	
+    CLLNode<IDInfo>* pUnitNode;
+	CvPlot* pLoopPlot;
+	int iDX, iDY;
+
+	iBestValue = MAX_INT;
+	pBestUnit = NULL;
+
+
+    for (iDX = -(iRange); iDX <= iRange; iDX++)
+	{
+		for (iDY = -(iRange); iDY <= iRange; iDY++)
+		{
+			pLoopPlot = plotXY(plot()->getX_INLINE(), plot()->getY_INLINE(), iDX, iDY);
+
+			if (pLoopPlot != NULL)
+			{
+				if (pLoopPlot->area() == plot()->area())
+				{
+					pUnitNode = pLoopPlot->headUnitNode();
+					while (pUnitNode != NULL)
+					{
+						pLoopUnit = ::getUnit(pUnitNode->m_data);
+						pUnitNode = pLoopPlot->nextUnitNode(pUnitNode);
+
+                        if (pLoopUnit != this)
+                        {
+                            if (pLoopUnit->isGroupHead())
+                            {
+                                if (!(pLoopUnit->isCargo()))
+                                {
+                                    if (pLoopUnit->AI_getUnitAIType() == eUnitAI)
+                                    {
+                                        if (canJoinGroup(pLoopUnit->plot(), pLoopUnit->getGroup()))
+                                        {
+                                            if (((pLoopUnit->getGroup()->AI_getMissionAIType()) != MISSIONAI_GROUP))
+                                            {
+                                                if (!bBiggerOnly || (pLoopUnit->getGroup()->getNumUnits() > getGroup()->getNumUnits()))
+                                                {
+                                                    if (generatePath(pLoopUnit->plot(), 0, true, &iPathTurns))
+                                                    {
+                                                        if (iPathTurns <= (iRange + 2))
+                                                        {
+                                                            iValue = iPathTurns;
+
+                                                            if (iValue < iBestValue)
+                                                            {
+                                                                iBestValue = iValue;
+                                                                pBestUnit = pLoopUnit;
+                                                            }
+                                                        }
+                                                    }
+                                                }
+                                            }
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+			}
+		}
+	}
+
+	if (pBestUnit != NULL)
+	{
+		if (atPlot(pBestUnit->plot()))
+		{
+			joinGroup(pBestUnit->getGroup());
+			return true;
+		}
+		else
+		{
+			getGroup()->pushMission(MISSION_MOVE_TO_UNIT, pBestUnit->getOwnerINLINE(), pBestUnit->getID(), 0, false, false, MISSIONAI_GROUP, NULL, pBestUnit);
+			return true;
+		}
+	}
+
+	return false;
+}
 
