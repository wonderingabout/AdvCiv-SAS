+	if (iProductionTotal < iProductionTarget)
+	{
+	    iProductionMultiplier += 8 * (iProductionTarget - iProductionTotal);
+	}
+
+	if ((iBonusFoodSurplus + iFeatureFoodSurplus > 5) && ((iBonusFoodDeficit + iHillFoodDeficit) > 5))
