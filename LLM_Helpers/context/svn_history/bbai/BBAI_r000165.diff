+int CvPlayer::startingPlotClosenessPenalty(CvPlot* pPlot, PlayerTypes ePlayer, int iRange)
+{
+	PROFILE_FUNC();
+
+	CvPlot* pStartingPlot;
+	
+	int iValue = 10000;
+
+	if (pPlot->getMinOriginalStartDist() == -1)
+	{
+		return 100;
+	}
+
+	if (pPlot->getMinOriginalStartDist() > ((iRange * 2) / 3))
+	{
+		return 100;
+	}
+
+	pStartingPlot = getStartingPlot();
+
+	if (pStartingPlot != NULL)
+	{
+		if (pStartingPlot->getArea() == pPlot->getArea())
+		{
+			if (GC.getGameINLINE().isTeamGame())
+			{
+				if (GET_PLAYER(ePlayer).getTeam() == getTeam())
+				{
+					iRange *= GC.getDefineINT("OWN_TEAM_STARTING_MODIFIER");
+					iRange /= 100;
+				}
+				else
+				{
+					iRange *= GC.getDefineINT("RIVAL_TEAM_STARTING_MODIFIER");
+					iRange /= 100;
+				}
+			}
+
+            int iDistance = plotDistance(pPlot->getX_INLINE(), pPlot->getY_INLINE(), pStartingPlot->getX_INLINE(), pStartingPlot->getY_INLINE());
+			if (iDistance <= iRange)
+			{
+			    iValue *= iDistance;
+			    iValue /= (iRange + 1);
+			    
+                iValue *= (iDistance + (iRange / 2));
+			    iValue /= (iRange + 1 + (iRange / 2));
+			}
+		}
+	}
+
+    iValue /= 100;
+    
+	return iValue;
+
+}
