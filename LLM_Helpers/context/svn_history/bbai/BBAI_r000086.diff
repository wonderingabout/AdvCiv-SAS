+// fast_sqrt from Wilco Dijkstra: mailto:[email redacted]
+// only works for 32 bit numbers (so if int is larger, or signed, it needs to be changed
+#define sqrt_iter1(N)			\
+	tryN = root + (1 << (N));	\
+	if (n >= tryN << (N))		\
+	{   n -= tryN << (N);		\
+		root |= 2 << (N);		\
+	}
+
+int fast_sqrt (int number)
+{
+	if (number <= 0)
+		return 0;
+	
+	unsigned int root = 0, n = number, tryN;
+	sqrt_iter1 (15);	sqrt_iter1 (14);	sqrt_iter1 (13);	sqrt_iter1 (12);
+	sqrt_iter1 (11);	sqrt_iter1 (10);	sqrt_iter1 ( 9);	sqrt_iter1 ( 8);
+	sqrt_iter1 ( 7);	sqrt_iter1 ( 6);	sqrt_iter1 ( 5);	sqrt_iter1 ( 4);
+	sqrt_iter1 ( 3);	sqrt_iter1 ( 2);	sqrt_iter1 ( 1);	sqrt_iter1 ( 0);
+	return root >> 1;
+}
+
+int plotRangeIndexToRange(int iIndex)
+{
+	//for (int diameter = 1; diameter < MAX_INT; diameter+= 2)
+	//{
+	//	if (iIndex < (diameter*diameter))
+	//		return (diameter/2);
+	//}
+
+	return ((fast_sqrt(iIndex)+1)/2);
+}
+
+int plotRangeIndexX(int iIndex)
+{
+	// if index is in the range for city plots, then use that cached value
+	if (false && iIndex < NUM_CITY_PLOTS)
