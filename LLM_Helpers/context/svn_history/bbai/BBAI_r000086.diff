+			iX = CITY_PLOTS_RADIUS * (1 + (((iIndex - NUM_CITY_PLOTS) % 2) * (-2)));
+		}
+		else
+		{
+			iX = 0;
+		}
+
+		return iX;
+	}
+}
+
