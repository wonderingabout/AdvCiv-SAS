+int CvCity::getHurryCostModifier(int iBaseModifier, int iProduction, bool bIgnoreNew)
+{
+	int iModifier = 100;
+	iModifier *= max(0, iBaseModifier + 100);
+	iModifier /= 100;
+
+	if (iProduction == 0 && !bIgnoreNew)
+	{
+		iModifier *= max(0, (GC.getDefineINT("NEW_HURRY_MODIFIER") + 100));
+		iModifier /= 100;
+	}
+
+	iModifier *= max(0, (GET_PLAYER(getOwnerINLINE()).getHurryModifier() + 100));
+	iModifier /= 100;
+
+	return iModifier;
+}
