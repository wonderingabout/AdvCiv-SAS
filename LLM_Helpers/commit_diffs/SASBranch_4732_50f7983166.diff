+		screen.setText(self.top.getNextWidgetName(), "", valueText,
+			CvUtil.FONT_LEFT_JUSTIFY, xValue, y, 0, FontTypes.SMALL_FONT,
+			WidgetTypes.WIDGET_GENERAL, -1, -1)
