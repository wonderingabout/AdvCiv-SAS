+		rand_field = f"iContact{short_name}RandAdjusted"
+
+		all_delays = []
+		all_rands = []
+
+		for leader_type in VALID_LEADERS_FOR_AGGREGATED_ATTRIBUTES:
+			leader_data = leaders_data[leader_type]
