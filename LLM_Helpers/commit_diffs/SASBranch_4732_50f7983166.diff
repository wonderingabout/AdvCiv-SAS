+						raise ValueError("[FATAL] At AI_ATTRIBUTE_DATA's stage and before normalization, in (aggregated) attr=%s and in leader_key=%s, raw_val=%d cannot be strictly out of bounds of min_val=%d and max_val=%d")
+
+				else:
