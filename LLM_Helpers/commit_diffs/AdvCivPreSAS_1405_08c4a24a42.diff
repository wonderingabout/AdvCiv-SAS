+		WorldSizeTypes.WORLDSIZE_STANDARD:	(16,10),
+		WorldSizeTypes.WORLDSIZE_LARGE:		(21,13),
+		WorldSizeTypes.WORLDSIZE_HUGE:		(26,16)
+	}
+
+	if (argsList[0] == -1): # (-1,) is passed to function on loads
+		return []
+	[eWorldSize] = argsList
+	return grid_sizes[eWorldSize]
