+	call("isClimateMap", lResult, m_python.getMapScriptModule(), false);
+	bClimateFlexible = toBool(lResult);
+	lResult = 1;
+	call("isSeaLevelMap", lResult, m_python.getMapScriptModule(), false);
+	bSeaLevelFlexible = toBool(lResult);
