@@ -3733,22 +3733,32 @@ int CvTeamAI::AI_declareWarTradeVal(TeamTypes eTarget, TeamTypes eSponsor) const
 {
 	// <advc.104o>
 	PROFILE_FUNC();
-	int r = -1;
+	int iTradeVal = -1;
 	if(getUWAI.isEnabled())
