+								}
+							}
+							if (k == tech_paths.back().second.size())
+							{
+								// haven't added it yet
+								tech_paths.back().second.push_back(j);
+							}
+						}
+					}
+				}
+				// Recalculate total value;
+				tech_paths.back().first = 0;
+				for (int k = 0; k < (int)tech_paths.back().second.size(); ++k)
