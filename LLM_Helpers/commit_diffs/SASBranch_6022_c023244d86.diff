+	g_kSASGameSummaryGlobalPrevious.bValid = true;
+	g_kSASGameSummaryGlobalPrevious.iGlobalWarmingIndex = iGlobalWarmingIndex;
+	g_kSASGameSummaryGlobalPrevious.iGlobalWarmingChances = iGlobalWarmingChances;
