+	r += 9 * std::min(9, std::max(iBestAreaFoundValue, iBestWaterAreaFoundValue) /
+			iMinFoundValue);
+	CvTeam const& kTeam = GET_TEAM(getTeam());
+	CvGame const& g = GC.getGameINLINE();
