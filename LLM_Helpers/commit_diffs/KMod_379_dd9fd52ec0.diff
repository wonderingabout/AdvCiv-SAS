+					int iTargetCities = GC.getWorldInfo(GC.getMapINLINE().getWorldSize()).getTargetNumCities();
+					FAssert(iCurrent > 0 && iNew > 0);
+					iMissionCost *= std::max(iCurrent, iNew) + iTargetCities;
+					iMissionCost /= iNew + iTargetCities;
+				}
+				// K-Mod end
 			}
 		}
 	}

