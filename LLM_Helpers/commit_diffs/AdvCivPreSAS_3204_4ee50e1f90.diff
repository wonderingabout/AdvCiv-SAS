diff --git a/CvGameCoreDLL/CvGameCoreUtils.h b/CvGameCoreDLL/CvGameCoreUtils.h
index 1ce24129c..fb5da386d 100644
--- a/CvGameCoreDLL/CvGameCoreUtils.h
