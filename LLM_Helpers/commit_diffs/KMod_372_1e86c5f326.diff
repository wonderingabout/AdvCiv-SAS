+CvPlot* KmodPathFinder::GetPathFirstPlot() const
+{
+	FAssert(end_node);
+	if (!end_node)
+		return NULL;
+
+	FAStarNode* node = end_node.get();
+
+	if (!node->m_pParent)
+		return GC.getMapINLINE().plotSorenINLINE(node->m_iX, node->m_iY);
+
+	while (node->m_pParent->m_pParent)
+	{
+		node = node->m_pParent;
+	}
+
+	return GC.getMapINLINE().plotSorenINLINE(node->m_iX, node->m_iY);
+}
