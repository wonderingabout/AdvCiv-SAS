+		int const iCityAtk = kU.getCityAttackModifier();
+		if (iCityAtk >= 50)
+		{
+			UnitClassTypes const eCls = (UnitClassTypes)kU.getUnitClassType();
+			if (eCls != NO_UNITCLASS)
+				iTotal += getUnitClassCount(eCls);
