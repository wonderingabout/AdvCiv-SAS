+}
+
+
+bool CvString::format(std::string & out, const char * fmt, ...)
+{
+	va_list args;
+	va_start(args,fmt);
+	bool r = formatv(out,fmt,args);
+	va_end(args);
+	return r;
+}
+
+
+void CvString::Format( LPCSTR lpszFormat, ...)
+{
+	std::string result;
+	va_list args;
+	va_start(args,lpszFormat);
+	formatv(result,lpszFormat,args);
+	va_end(args);
+	*this = result;
+}

