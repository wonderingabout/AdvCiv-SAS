+Target_BIN=$(TARGET)\CvGameCoreDLL.dll
+Target_BIN_TEMP=$(TEMP_TARGET_FILES)\CvGameCoreDLL.dll
+
+!IF [IF NOT EXIST CvGameCoreDLL.rc EXIT 1] == 0
