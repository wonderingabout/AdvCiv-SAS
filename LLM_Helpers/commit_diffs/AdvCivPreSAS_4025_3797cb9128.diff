+int CvTeam::getCapitulationTurn() const
+{
+	if (!isCapitulated())
+		return -1;
+	FOR_EACH_DEAL(pDeal)
+	{
+		if (pDeal->isVassalDeal() && pDeal->isBetween(getID(), getMasterTeam()))
+			return GC.getGame().getGameTurn() - pDeal->getAge();
+	}
+	return -1;
