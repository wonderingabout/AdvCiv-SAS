+	// Subtracts iValue from iGood if it is positive or its negative from iBad if it is negative.
+	void subtractGoodOrBad(int iValue, int& iGood, int& iBad)
+	{
+		if (iValue > 0)
+			iGood -= iValue;
+		else if (iValue < 0)
+			iBad += iValue;
+	}
