+	// Adds iValue to iGood if it is positive or its negative to iBad if it is negative.
+	void addGoodOrBad(int iValue, int& iGood, int& iBad)
+	{
+		if (iValue > 0)
+			iGood += iValue;
+		else if (iValue < 0)
+			iBad -= iValue;
