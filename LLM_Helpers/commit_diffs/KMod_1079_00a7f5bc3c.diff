+				if (!kOurTeam.isAtWar(i))
+					kOurTeam.AI_setWarPlan(i, NO_WARPLAN, false);
+			}
+		}
+		else
+			kOurTeam.AI_setWarPlan((TeamTypes)iData1, (WarPlanTypes)iData2, false);
+		break;
+	}
+	// K-Mod end
 
 	default:
 		FAssert(false);

