 		break;
+	// K-Mod
+	case DIPLOEVENT_SET_WARPLAN:
+	{
+		CvTeamAI& kOurTeam = GET_TEAM(getTeam());
+		FAssert(kOurTeam.getAtWarCount(true) == 0);
+		if (iData1 == NO_TEAM)
+		{
+			FAssert(iData2 == NO_WARPLAN);
+			for (TeamTypes i = (TeamTypes)0; i < MAX_CIV_TEAMS; i=(TeamTypes)(i+1))
