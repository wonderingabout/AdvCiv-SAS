+<?xml version="1.0" encoding="ISO-8859-1"?>
+<!-- advc.700: Game text for the Rise and Fall option. Mostly new text;
+	 the few modified BtS text elements are tagged with a comment saying
+	 "redefine". -->
+<Civ4GameText>
+
+	<TEXT>
+		<Tag>TXT_KEY_RF_REPLAY_NEXT_CHAPTER</Tag>
+		<English>Start of Chapter %d1_Num: Player controls %s2.</English>
+		<German>Beginn Abschnitt %d1_Num1: Spieler steuert %s2.</German>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_RF_CHAPTER_COUNTDOWN</Tag>
+		<English>Turn  %d1_Trn/%d2_Trn</English>
+		<German>Runde  %d1_Trn/%d2_Trn</German>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_RF_INTERLUDE_COUNTDOWN</Tag>
+		<English>Auto Play: %d1_Trn</English>
+		<German>Autom. Runden: %d1_Trn</German>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_RF_NO_THANKS</Tag>
+		<English>We can't accept gifts from you. Let's haggle instead?</English>
+		<German>Geschenke k�nnen wir von Euch nicht annehmen. Wollt Ihr nicht feilschen?</German>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_RF_POPUP_FINAL_TURN</Tag>
+		<English>This is the final turn of Chapter %d1_Chpt. Any lasting decisions on the last minute? (Start/ end wars, civic changes, promotions, use of Great People ...). Have you already decided on your next civ?</English>
+		<German>Letzte Runde des %d1_Chpt. Abschnitts. Noch weitreichende Entscheidungen auf den letzten Dr�cker? (Krieg/ Frieden, Staatsform, Bef�rderungen, Einsatz Gro�er Pers�nlichkeiten ...). Haben Sie Ihre n�chste Zivilisation ins Auge gefasst?</German>
+	</TEXT>
+	<TEXT>
