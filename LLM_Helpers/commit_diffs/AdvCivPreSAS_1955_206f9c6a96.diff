-	uninit();
-}
-
-
-template <class T>
-void FFreeListArray<T>::init(int iNumSlots)
-{
-	int iI;
-
-	uninit();
-
-	m_iFreeListHead = FLA_FREE_LIST_INDEX;
-	m_iFreeListCount = 0;
-	m_iLastIndex = FFreeList::INVALID_INDEX;
-	m_iNumSlots = iNumSlots;
-
-	if (m_iNumSlots > 0)
-	{
