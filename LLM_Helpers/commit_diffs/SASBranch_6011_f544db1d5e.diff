+		if (kActivePlayer.getHandicapType() != NO_HANDICAP)
+			szActiveHandicap = GC.getInfo(kActivePlayer.getHandicapType()).getType();
+	}
+	CvString szGameOptions;
+	FOR_EACH_ENUM(GameOption)
