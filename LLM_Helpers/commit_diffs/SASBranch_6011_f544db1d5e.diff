+		if (!kGame.isOption(eLoopGameOption))
+			continue;
+		if (!szGameOptions.empty())
+			szGameOptions += ",";
+		szGameOptions += GC.getInfo(eLoopGameOption).getType();
+	}
+	if (szGameOptions.empty())
+		szGameOptions = "-";
