+	rollSASBBAILog("new");
+	logBBAI("BBAI_NEW_GAME_INITIALIZING utc=%s logFile=%s", getSASBBAILogTimestamp().GetCString(), getSASBBAILogName().GetCString());
+	logSASBBAILogSettings();
+}
