+{
+	if (szValue == NULL)
+		return "-";
+	CvString szQuoted = "\"";
+	for (int iI = 0; szValue[iI] != '\0'; iI++)
+	{
+		const char c = szValue[iI];
+		if (c == '\\')
+			szQuoted += "\\\\";
+		else if (c == '"')
+			szQuoted += "\\\"";
+		else if (c == '\n')
+			szQuoted += "\\n";
+		else if (c == '\r')
+			szQuoted += "\\r";
+		else if (c == '\t')
+			szQuoted += "\\t";
+		else szQuoted += c;
+	}
+	szQuoted += "\"";
+	return szQuoted;
+}
