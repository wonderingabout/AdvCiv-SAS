+	for (int iI = 0; iI < NUM_UNITAI_TYPES; iI++)
+		appendSASGameRecordTypeCount(szUnitAI, getSASGameRecordUnitAIType((UnitAITypes)iI), aiUnitAI[iI]);
+	for (int iI = 0; iI < GC.getNumUnitCombatInfos(); iI++)
