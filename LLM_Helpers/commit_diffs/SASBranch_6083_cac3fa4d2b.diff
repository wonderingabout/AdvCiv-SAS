+			if (!kLoopTeam.isAlive() || kLoopTeam.isBarbarian())
+				continue;
+			if (kLoopTeam.isVotingMember(eLoopVoteSource))
+				appendSASGameRecordIntList(szVotingTeams, eLoopTeam);
