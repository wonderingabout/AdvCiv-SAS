+		}
+	}
+	CvString szBuilds;
+	for (int iI = 0; iI < GC.getNumBuildInfos(); iI++)
+		appendSASGameRecordTypeCount(szBuilds, getSASGameRecordBuildType((BuildTypes)iI), aiBuilds[iI]);
