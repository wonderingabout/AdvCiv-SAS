+	static const bool bSAS_AI_EVACUATE_CITY_ALWAYS_EVACUATE_DOOMED_CITIES = GC.getDefineBOOL("SAS_AI_EVACUATE_CITY_ALWAYS_EVACUATE_DOOMED_CITIES");
