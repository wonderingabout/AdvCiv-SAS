+		// Mustn't serialize pointers
+		/*TestStream stream;
+		test.write(&stream);*/ // Should fail static assertion
+	}
+	{	// Yield change map (4x char)
+		YieldChangeMap test;
+		FAssert(test.get(YIELD_PRODUCTION) == 0);
