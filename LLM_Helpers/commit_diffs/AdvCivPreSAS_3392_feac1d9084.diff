+		FAssert(test.get(eOuterKey, eInnerKey) == 1);
+		test.resetVal(eOuterKey, eInnerKey);
+		FAssert(test.get(eOuterKey, eInnerKey) == 0);
+		FAssert(test.get(eOuterKey) != NULL);
+		FAssert(!test.isAnyNonDefault());
+		test.resetVal(eOuterKey);
+		FAssert(test.get(eOuterKey) == NULL);
