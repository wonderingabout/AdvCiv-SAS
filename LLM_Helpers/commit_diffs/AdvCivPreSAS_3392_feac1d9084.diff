+		}
+		TestStream stream;
+		test.write(&stream);
+		test.reset();
+		test.read(&stream);
+		FAssert(other.numNonDefault() == 2);
+	}
+	{	// Boolean array enum map with a single block of static memory
+		ArrayEnumMap<DirectionTypes,bool> test;
+		FAssert(!test.get(DIRECTION_NORTH));
