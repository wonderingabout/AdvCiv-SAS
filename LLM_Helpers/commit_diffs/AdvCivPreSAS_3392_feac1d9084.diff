+		CvRandom rng;
+		rng.init(intHash(kInputs, ePlayer));
+		return rng.getFloat();
+	}
+	// For hashing just a single input
+	inline float hash(int iInputs, PlayerTypes ePlayer = NO_PLAYER)
+	{
+		std::vector<int> inputs;
+		inputs.push_back(iInputs);
+		return hash(inputs, ePlayer);
+	}
+} // </advc.003g>
 
