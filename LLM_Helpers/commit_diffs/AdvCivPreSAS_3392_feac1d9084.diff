+		ArrayEnumMap<DirectionTypes,bool> other = test;
+		FAssert(other.numNonDefault() == 2);
+		FOR_EACH_NON_DEFAULT_PAIR(test, Direction, bool)
+		{
+			FAssert(perDirectionVal.second);
