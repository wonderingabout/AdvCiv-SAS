+	int iSaveVersion;
+	{
+		int iTmp;
+		pStream->Read(&iTmp);
+		iSaveVersion = iTmp / 1000;
+		if (iSaveVersion <= 0)
+			m_eTypicalUnit = (UnitTypes)iTmp;
+		else m_eTypicalUnit = (UnitTypes)((iTmp % 1000) - 1);
