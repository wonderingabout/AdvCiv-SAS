-// <advc> (Will have to explicitly set DEFAULT=-1 when T is an enum type)
-template<class T, int DEFAULT = 0>
-class CivPlayerMap : public EnumMapBase <PlayerTypes, T, DEFAULT, CivPlayerTypes, CivPlayerTypes> {};
