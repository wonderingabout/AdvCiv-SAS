+
+	int iLoop=-1;
+	for(CvCity* pLoopCity = firstCity(&iLoop); pLoopCity != NULL;
+			pLoopCity = nextCity(&iLoop)) {
+		eBestUnit = pLoopCity->AI_bestUnitAI(UNITAI_ATTACK, true);
+		if(eBestUnit != NO_UNIT)
+			break;
+	}
+	return eBestUnit;
