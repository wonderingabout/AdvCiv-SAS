+UnitTypes CvPlayerAI::AI_getBestAttackUnit() const {
+
+	UnitTypes eBestUnit = NO_UNIT;
+
+	CvCity* pCapitalCity = getCapitalCity();
+	if(pCapitalCity != NULL) {
+		eBestUnit = pCapitalCity->AI_bestUnitAI(UNITAI_ATTACK, true);
