+			{
+/************************************************************************************************/
+/* BETTER_BTS_AI_MOD                      12/30/08                                jdog5000      */
+/*                                                                                              */
+/* Diplomacy AI                                                                                 */
+/************************************************************************************************/
+				if( bFriendlyToSecretary )
