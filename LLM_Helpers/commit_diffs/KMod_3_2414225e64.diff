+void CvPlayer::showMissedMessages()
+{
+	CvMessageQueue::iterator it = m_listGameMessages.begin();
+	while (it != m_listGameMessages.end())
+	{
+		CvTalkingHeadMessage& msg = *it;
+		if (!msg.getShown())
+		{
+			msg.setShown(true);
+			gDLL->getInterfaceIFace()->showMessage(msg);
+		}
+		++it;
+	}
+}
