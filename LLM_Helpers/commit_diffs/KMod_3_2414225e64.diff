+	pStream->Write(m_iNeededFloatingDefenders);
+	pStream->Write(m_iNeededFloatingDefendersCacheTurn);
+	pStream->Write(m_iWorkersNeeded);
+	pStream->Write(m_iWorkersHave);
+}
