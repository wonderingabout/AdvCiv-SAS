+bool CvGame::isVotePassed(VoteTypes eIndex) const
+{
+	PlayerVoteTypes ePlayerVote = getVoteOutcome(eIndex);
+
+	if (isTeamVote(eIndex))
+	{
+		return (ePlayerVote >= 0 && ePlayerVote < MAX_CIV_TEAMS);
+	}
+	else
+	{
+		return (ePlayerVote == PLAYER_VOTE_YES);
+	}
