+	int iID;
+
+	bool operator== (const IDInfo& info) const
+	{
+		return (eOwner == info.eOwner && iID == info.iID);
+	}
+
+	void reset()
+	{
+		eOwner = NO_PLAYER;
+		iID = FFreeList::INVALID_INDEX;
+	}
+};
