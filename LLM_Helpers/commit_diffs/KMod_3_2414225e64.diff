+				}
+			}
+		}
+	}
+/************************************************************************************************/
+/* BETTER_BTS_AI_MOD                       END                                                  */
+/************************************************************************************************/
+
+
+	// City circles when in Advanced Start
+	if (gDLL->getInterfaceIFace()->isInAdvancedStart())
+	{
