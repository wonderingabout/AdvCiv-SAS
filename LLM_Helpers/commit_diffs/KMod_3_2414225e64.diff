+
+void CvCity::clearTradeRoutes()
+{
+	CvCity* pLoopCity;
+	int iI;
+
+	for (iI = 0; iI < GC.getDefineINT("MAX_TRADE_ROUTES"); iI++)
+	{
+		pLoopCity = getTradeCity(iI);
+
+		if (pLoopCity != NULL)
+		{
+			pLoopCity->setTradeRoute(getOwnerINLINE(), false);
+		}
+
+		m_paTradeCities[iI].reset();
+	}
+}
