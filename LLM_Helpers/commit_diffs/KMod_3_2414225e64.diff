+bool CvUnitAI::AI_canGroupWithAIType(UnitAITypes eUnitAI) const
+{
+	if (eUnitAI != AI_getUnitAIType())
+	{
+		switch (eUnitAI)
+		{
+		case (UNITAI_ATTACK_CITY):
+			if (plot()->isCity() && (GC.getGame().getGameTurn() - plot()->getPlotCity()->getGameTurnAcquired()) <= 1)
+			{
+				return false;
+			}
+			break;
+		default:
+			break;
+		}
+	}
+
+	return true;
+}
