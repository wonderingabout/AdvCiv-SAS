+void CvSelectionGroup::kill()
+{
+	FAssert(getOwnerINLINE() != NO_PLAYER);
+	FAssertMsg(getID() != FFreeList::INVALID_INDEX, "getID() is not expected to be equal with FFreeList::INVALID_INDEX");
