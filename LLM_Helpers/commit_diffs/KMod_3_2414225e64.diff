+CvCity* CvCity::getTradeCity(int iIndex) const
+{
+	FAssert(iIndex >= 0);
+	FAssert(iIndex < GC.getDefineINT("MAX_TRADE_ROUTES"));
+	return getCity(m_paTradeCities[iIndex]);
+}
