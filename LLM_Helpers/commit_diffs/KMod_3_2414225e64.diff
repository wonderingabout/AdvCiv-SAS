+bool CvSelectionGroup::isStranded()
+{
+	PROFILE_FUNC();
+
+	if( !(m_bIsStrandedCacheValid) )
+	{
+		m_bIsStrandedCache = calculateIsStranded();
+		m_bIsStrandedCacheValid = true;
+	}
+		
+	return m_bIsStrandedCache;
+}
