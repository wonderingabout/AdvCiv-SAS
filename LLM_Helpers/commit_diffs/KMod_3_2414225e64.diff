+//
+// Set initial items (units, techs, etc...)
+//
+void CvGame::setInitialItems()
+{
+	PROFILE_FUNC();
+
+	initFreeState();
+	assignStartingPlots();
+	normalizeStartingPlots();
+	initFreeUnits();
+
+	for (int i = 0; i < MAX_PLAYERS; ++i)
+	{
+		CvPlayer& kPlayer = GET_PLAYER((PlayerTypes)i);
+		if (kPlayer.isAlive())
+		{
+			kPlayer.AI_updateFoundValues();
+		}
+	}
+}
