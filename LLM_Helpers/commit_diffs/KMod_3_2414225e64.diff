+	pXML->GetChildXmlValByName(&m_bPrereqReligion, "bPrereqReligion");
+	pXML->GetChildXmlValByName(&m_bMechanized,"bMechanized",false);
+	pXML->GetChildXmlValByName(&m_bRenderBelowWater,"bRenderBelowWater",false);
