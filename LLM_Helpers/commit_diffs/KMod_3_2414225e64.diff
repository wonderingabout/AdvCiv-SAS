+			FAssert(!atPlot(pBestPlot));
+/************************************************************************************************/
+/* BETTER_BTS_AI_MOD                      03/09/09                                jdog5000      */
+/*                                                                                              */
+/* Unit AI                                                                                      */
+/************************************************************************************************/
+			getGroup()->pushMission(MISSION_MOVE_TO, pBestPlot->getX_INLINE(), pBestPlot->getY_INLINE(), MOVE_SAFE_TERRITORY);
+/************************************************************************************************/
+/* BETTER_BTS_AI_MOD                       END                                                  */
