+CvArea* CvMap::findBiggestArea(bool bWater)
+{
+	CvArea* pLoopArea;
+	CvArea* pBestArea;
+	int iValue;
+	int iBestValue;
+	int iLoop;
+
+	iBestValue = 0;
+	pBestArea = NULL;
+
+	for(pLoopArea = firstArea(&iLoop); pLoopArea != NULL; pLoopArea = nextArea(&iLoop))
+	{
+		if (pLoopArea->isWater() == bWater)
+		{
+			iValue = pLoopArea->getNumTiles();
+
+			if (iValue > iBestValue)
+			{
+				iBestValue = iValue;
+				pBestArea = pLoopArea;
+			}
+		}
+	}
+
+	return pBestArea;
+}
