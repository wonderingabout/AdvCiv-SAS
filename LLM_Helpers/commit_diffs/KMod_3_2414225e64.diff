+	}
+
+	iValue -= (iValue % GC.getDefineINT("DIPLOMACY_VALUE_REMAINDER"));
+
+	if (isHuman())
+	{
+		return std::max(iValue, GC.getDefineINT("DIPLOMACY_VALUE_REMAINDER"));
