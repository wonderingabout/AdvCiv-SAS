+		break;
+	case TRADE_RELIGION:
+		if (bOffer)
+		{
+			szString = gDLL->getText("TXT_KEY_TRADE_CONVERT");
+			szString += GC.getReligionInfo((ReligionTypes)zTradeData.m_iData).getDescription();
+		}
+		else
+		{
+			szString = GC.getReligionInfo((ReligionTypes)zTradeData.m_iData).getDescription();
+		}
