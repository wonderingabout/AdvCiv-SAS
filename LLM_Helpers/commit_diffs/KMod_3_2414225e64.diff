+void CvPlot::setLayoutDirty(bool bDirty)
+{
+	if (!GC.IsGraphicsInitialized())
+	{
+		return;
+	}
+
+	if (isLayoutDirty() != bDirty)
+	{
+		m_bPlotLayoutDirty = bDirty;
+
+		if (isLayoutDirty() && (m_pPlotBuilder == NULL))
+		{
+			if (!updatePlotBuilder())
+			{
+				m_bPlotLayoutDirty = false;
+			}
+		}
+	}
+}
