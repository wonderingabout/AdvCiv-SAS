+bool CvUnitAI::AI_guardFort(bool bSearch)
+{
+	PROFILE_FUNC();
+	
+	if (plot()->getOwnerINLINE() == getOwnerINLINE())
+	{
+		ImprovementTypes eImprovement = plot()->getImprovementType();
