+		if (GET_TEAM((TeamTypes)iI).isAlive())
+		{
+			if (!bIgnoreMinors || !(GET_TEAM((TeamTypes)iI).isMinorCiv()))
+			{
+				if( !bIgnoreVassals || !(GET_TEAM((TeamTypes)iI).isAVassal()))
+				{
