+bool CvUnitAI::AI_infiltrate()
+{
+	PROFILE_FUNC();
+
+	CvCity* pLoopCity;
+	CvPlot* pBestPlot;
+
+	int iPathTurns;
+	int iValue;
+	int iBestValue;
+	int iLoop;
+	int iI;
+
+	iBestValue = 0;
+	pBestPlot = NULL;
+	
+	if (canInfiltrate(plot()))
