+int CvCityAI::AI_minDefenders()
+{
+	int iDefenders = 1;
+	int iEra = GET_PLAYER(getOwnerINLINE()).getCurrentEra();
+	if (iEra > 0)
+	{
+		iDefenders++;
+	}
+	if (((iEra - GC.getGame().getStartEra() / 2) >= GC.getNumEraInfos() / 2) && isCoastal(GC.getMIN_WATER_SIZE_FOR_OCEAN()))
+	{
+		iDefenders++;
+	}
+	
+	return iDefenders;
+}
