+	// free vassals
+	if (0 == m_iAliveCount)
+	{
+		for (int iTeam = 0; iTeam < MAX_TEAMS; iTeam++)
+		{
+			if (iTeam != getID())
+			{
+				CvTeam& kLoopTeam = GET_TEAM((TeamTypes)iTeam);
