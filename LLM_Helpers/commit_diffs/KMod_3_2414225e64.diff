+void CvInitCore::setType(const CvWString & szType)
+{
+	if (wcsicmp(szType.GetCString(), L"singleplayer") == 0)
+	{
+		setType(GAME_SP_NEW);
+	}
+	else if (wcsicmp(szType.GetCString(), L"spload") == 0)
+	{
+		setType(GAME_SP_LOAD);
+	}
+	else
+	{
