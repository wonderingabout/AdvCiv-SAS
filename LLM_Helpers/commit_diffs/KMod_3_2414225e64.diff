+bool CvPlayer::canReceiveTradeCity() const
+{
+	if (GC.getGameINLINE().isOption(GAMEOPTION_ONE_CITY_CHALLENGE) && isHuman())
+	{
+		return false;
+	}
+
+	return true;
+}
