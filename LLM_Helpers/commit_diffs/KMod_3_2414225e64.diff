+
+	if (pCity == NULL)
+	{
+		return false;
+	}
+
+	if (pCity->getOwnerINLINE() != getOwnerINLINE())
+	{
+		return false;
+	}
+
+	if (getGreatWorkCulture(pPlot) == 0)
+	{
+		return false;
+	}
+
+	return true;
+}
