+		KB_TAB        ,
+		KB_LBRACKET   ,
+		KB_RBRACKET   ,
+		KB_RETURN     ,		/* Enter on main keyboard */
+		KB_LCONTROL   ,
+		KB_SEMICOLON  ,
+		KB_APOSTROPHE ,
+		KB_GRAVE      ,		/* accent grave */
+		KB_LSHIFT     ,
+		KB_BACKSLASH  ,
+		KB_COMMA      ,
+		KB_PERIOD     ,
+		KB_SLASH      ,
+		KB_RSHIFT     ,
+		KB_NUMPADSTAR   ,
+		KB_LALT      ,	
+		KB_SPACE      ,
+		KB_CAPSLOCK    ,
+		KB_F1         ,
+		KB_F2         ,
+		KB_F3         ,
+		KB_F4         ,
+		KB_F5         ,
+		KB_F6         ,
