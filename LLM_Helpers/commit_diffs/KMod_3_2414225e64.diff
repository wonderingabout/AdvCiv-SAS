+void CvCityAI::AI_cachePlayerCloseness(int iMaxDistance)
+{
+	PROFILE_FUNC();
+	CvCity* pLoopCity;
+	int iI;
+	int iLoop;
+	int iValue;
+	int iTempValue;
+	int iBestValue;
+
+/********************************************************************************/
+/* 	BETTER_BTS_AI_MOD						5/16/10				jdog5000		*/
