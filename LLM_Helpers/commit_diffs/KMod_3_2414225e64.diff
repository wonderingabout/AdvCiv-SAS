+RouteTypes CvSelectionGroup::getBestBuildRoute(CvPlot* pPlot, BuildTypes* peBestBuild) const
+{
+	PROFILE_FUNC();
+
+	CLLNode<IDInfo>* pUnitNode;
+	CvUnit* pLoopUnit;
+	RouteTypes eRoute;
+	RouteTypes eBestRoute;
+	int iValue;
+	int iBestValue;
+	int iI;
+
+	if (peBestBuild != NULL)
+	{
+		*peBestBuild = NO_BUILD;
+	}
+
+	iBestValue = 0;
+	eBestRoute = NO_ROUTE;
+
+	pUnitNode = headUnitNode();
+
+	while (pUnitNode != NULL)
+	{
+		pLoopUnit = ::getUnit(pUnitNode->m_data);
+		pUnitNode = nextUnitNode(pUnitNode);
+
+		for (iI = 0; iI < GC.getNumBuildInfos(); iI++)
+		{
+			eRoute = ((RouteTypes)(GC.getBuildInfo((BuildTypes) iI).getRoute()));
+
+			if (eRoute != NO_ROUTE)
+			{
+				if (pLoopUnit->canBuild(pPlot, ((BuildTypes)iI)))
+				{
+					iValue = GC.getRouteInfo(eRoute).getValue();
+
+					if (iValue > iBestValue)
+					{
+						iBestValue = iValue;
+						eBestRoute = eRoute;
+						if (peBestBuild != NULL)
+						{
+							*peBestBuild = ((BuildTypes)iI);
+						}
+					}
+				}
+			}
+		}
+	}
+
+	return eBestRoute;
+}
