+			iValue /= 4; 
+			iValue += 6 * getNumCities();
+			iValue += 20; 
+		}
+	}
+
+	if (AI_isDoVictoryStrategy(AI_VICTORY_CULTURE2) && (GC.getCivicInfo(eCivic).isNoNonStateReligionSpread()))
+	{
+	    iValue /= 10;	    
+	}
+
+	return iValue;
+}
