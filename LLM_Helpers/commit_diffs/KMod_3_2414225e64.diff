+bool CvPlot::isFreshWater() const
+{
+	CvPlot* pLoopPlot;
+	int iDX, iDY;
+
+	if (isWater())
+	{
+		return false;
+	}
+
+	if (isImpassable())
+	{
+		return false;
+	}
+
+	if (isRiver())
+	{
+		return true;
+	}
+
+	for (iDX = -1; iDX <= 1; iDX++)
+	{
+		for (iDY = -1; iDY <= 1; iDY++)
+		{
+			pLoopPlot	= plotXY(getX_INLINE(), getY_INLINE(), iDX, iDY);
+
+			if (pLoopPlot != NULL)
+			{
+				if (pLoopPlot->isLake())
+				{
+					return true;
+				}
+
+				if (pLoopPlot->getFeatureType() != NO_FEATURE)
+				{
+					if (GC.getFeatureInfo(pLoopPlot->getFeatureType()).isAddsFreshWater())
+					{
+						return true;
+					}
+				}
+			}
+		}
+	}
+
+	return false;
