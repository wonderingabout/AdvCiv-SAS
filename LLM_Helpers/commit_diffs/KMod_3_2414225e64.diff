+
+		if (kTrigger.getNumTerrainsRequired() > 0)
+		{
+			return true;
+		}
+
+		if (kTrigger.getNumImprovementsRequired() > 0)
+		{
+			return true;
+		}
+
+		if (kTrigger.getNumBonusesRequired() > 0)
+		{
+			return true;
+		}
+
+		if (kTrigger.getNumRoutesRequired() > 0)
