+int CvCity::conscriptMinCityPopulation() const
+{
+	int iPopulation;
+
+	iPopulation = GC.getDefineINT("CONSCRIPT_MIN_CITY_POPULATION");
+
+	iPopulation += getConscriptPopulation();
+
+	return iPopulation;
