+void CvUnit::checkRemoveSelectionAfterAttack()
+{
+	if (!canMove() || !isBlitz())
+	{
+		if (IsSelected())
+		{
+			if (gDLL->getInterfaceIFace()->getLengthSelectionList() > 1)
+			{
+				gDLL->getInterfaceIFace()->removeFromSelectionList(this);
+			}
+		}
+	}
+}
