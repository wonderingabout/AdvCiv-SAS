+			{
+				return true;
+			}
+			break;
+
+		case MISSION_PILLAGE:
+			if (pLoopUnit->canPillage(pPlot))
+			{
+				return true;
+			}
+			break;
+
+		case MISSION_SABOTAGE:
+			if (pLoopUnit->canSabotage(pPlot, bTestVisible))
