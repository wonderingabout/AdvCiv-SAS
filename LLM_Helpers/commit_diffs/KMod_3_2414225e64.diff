+{
+	const TCHAR* pcTag = getMovieDefineTag();
+	if (NULL != pcTag && 0 != _tcscmp(pcTag, "NONE"))
+	{
+		return ARTFILEMGR.getMovieArtInfo(pcTag);
+	}
+	else
+	{
+		return NULL;
+	}
+}
