+//
+//------------------------------------------------------------------------------------------------------
+bool CvXMLLoadUtility::GetXmlVal(char* pszVal, char* pszDefault)
+{
+	if (pszDefault)
+	{
+		strcpy(pszVal, pszDefault);
+	}
+	else
+	{
+		strcpy(pszVal, "");
+	}
+
+	// skip to the next non-comment node
