+	if (isDelayedDeath())
+	{
+		return false;
+	}
+
+	if (GC.getGameINLINE().isOption(GAMEOPTION_NO_ESPIONAGE))
+	{
+		return false;
+	}
+
+	if (getEspionagePoints(NULL) == 0)
+	{
+		return false;
+	}
+
+	CvCity* pCity = pPlot->getPlotCity();
+	if (pCity == NULL || pCity->isBarbarian())
+	{
+		return false;
+	}
+
+	if (!bTestVisible)
+	{
+		if (NULL != pCity && pCity->getTeam() == getTeam())
+		{
+			return false;
+		}
+	}
+
+	return true;
+}
