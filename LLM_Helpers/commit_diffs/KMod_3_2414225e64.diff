+int CvPlayerAI::AI_getTotalAreaCityThreat(CvArea* pArea) const
+{
+	PROFILE_FUNC();
+	CvCity* pLoopCity;
+	int iLoop;
+	int iValue;
+	
+	iValue = 0;
+	for (pLoopCity = firstCity(&iLoop); pLoopCity != NULL; pLoopCity = nextCity(&iLoop))
+	{
+		if (pLoopCity->getArea() == pArea->getID())
+		{
+			iValue += pLoopCity->AI_cityThreat();
+		}
+	}
+	return iValue;
