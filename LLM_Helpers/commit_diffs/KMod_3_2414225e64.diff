+bool CvDeal::isVassalTrade(const CLinkList<TradeData>* pList)
+{
+	if (pList)
+	{
+		for (CLLNode<TradeData>* pNode = pList->head(); pNode != NULL; pNode = pList->next(pNode))
+		{
+			if (isVassal(pNode->m_data.m_eItemType))
+			{
+				return true;
+			}
+		}
+	}
+
+	return false;
+}
