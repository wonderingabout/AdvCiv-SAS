+void CvPlayer::trigger(const EventTriggeredData& kData)
+{
+	if (isHuman())
+	{
+		CvPopupInfo* pInfo = new CvPopupInfo(BUTTONPOPUP_EVENT, kData.getID());
+		addPopup(pInfo);
