+	bStarted = false;
+
+	for (iI = 0; iI < NUM_YIELD_TYPES; ++iI)
+	{
+		if (piYieldChange[iI] != 0)
+		{
+			if (!bStarted)
+			{
+				if (bNewLine)
+				{
+					szTempBuffer.Format(L"\n%c", gDLL->getSymbolID(BULLET_CHAR));
+				}
+				szTempBuffer += CvWString::format(L"%s%s%s%d%s%c",
+					szStart.GetCString(),
+					szSpace.GetCString(),
+					piYieldChange[iI] > 0 ? L"+" : L"",
