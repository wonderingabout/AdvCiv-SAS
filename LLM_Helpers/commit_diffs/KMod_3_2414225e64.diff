+int CvUnitAI::AI_exploreAirPlotValue( CvPlot* pPlot )
+{
+	int iValue = 0;
+	if (pPlot->isVisible(getTeam(), false))
+	{
+		iValue++;
+
+		if (!pPlot->isOwned())
+		{
+			iValue++;
+		}
+
+		if (!pPlot->isImpassable())
+		{
+			iValue *= 4;
+
+			if (pPlot->isWater() || pPlot->getArea() == getArea())
+			{
+				iValue *= 2;
+			}
+		}
+	}
+
+	return iValue;
+}
