+bool CvEventTriggerInfo::read(CvXMLLoadUtility* pXML)
+{
+	CvString szTextVal;
+
+	if (!CvInfoBase::read(pXML))
+	{
+		return false;
+	}
+
+	pXML->GetChildXmlValByName(&m_iPercentGamesActive, "iPercentGamesActive");
+	pXML->GetChildXmlValByName(&m_iProbability, "iWeight");
+
