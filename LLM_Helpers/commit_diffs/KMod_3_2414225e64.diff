+// Returns true if a mission was pushed or we should wait for another unit to bombard...
+bool CvUnitAI::AI_followBombard()
+{
+	CLLNode<IDInfo>* pUnitNode;
+	CvUnit* pLoopUnit;
+	CvPlot* pAdjacentPlot1;
+	CvPlot* pAdjacentPlot2;
