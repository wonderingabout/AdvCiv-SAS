+							{
+								continue;
+							}
+/************************************************************************************************/
+/* UNOFFICIAL_PATCH                        END                                                  */
+/************************************************************************************************/
+
+							int iValue = (pLoopCity->getPopulation() * 4);
+
+							if (pLoopCity->getOwnerINLINE() == getOwnerINLINE())
+							{
+								iValue *= 4;
+							}
+							else
+							{
+								iValue *= 3;
+							}
+							
+							if (iValue > iBestValue)
