+void CvCity::clearOrderQueue()
+{
+	while (headOrderQueueNode() != NULL)
+	{
+		popOrder(0);
+	}
+
+	if ((getTeam() == GC.getGameINLINE().getActiveTeam()) || GC.getGameINLINE().isDebugMode())
+	{
+		setInfoDirty(true);
+	}
+}
