+			}
+			iTempValue += (GC.getHurryInfo((HurryTypes)iI).getProductionPerPopulation() * getNumCities() * (bWarPlan ? 2 : 1)) / 5;
+			iValue += iTempValue;
+		}
+	}
+
+	for (iI = 0; iI < GC.getNumSpecialBuildingInfos(); iI++)
