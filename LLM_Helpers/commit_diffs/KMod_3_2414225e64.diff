+bool CvUnitAI::AI_spreadCorporationAirlift()
+{
+	PROFILE_FUNC();
+	
+	if (getGroup()->getNumUnits() > 1)
+	{
+		return false;
+	}
+
+	CvCity* pCity = plot()->getPlotCity();
+
