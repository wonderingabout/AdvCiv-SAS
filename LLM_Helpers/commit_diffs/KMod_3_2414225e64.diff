+bool CvPlayer::canConvert(ReligionTypes eReligion) const
+{
+	if (isBarbarian())
+	{
+		return false;
+	}
+
+	if (isAnarchy())
+	{
+		return false;
+	}
+
+	if (getConversionTimer() > 0)
+	{
+		return false;
+	}
+
+	if (!isStateReligion())
+	{
+		return false;
+	}
+
+	if (getLastStateReligion() == eReligion)
+	{
+		return false;
+	}
+
+	if (eReligion != NO_RELIGION)
+	{
+		if (!canDoReligion(eReligion))
+		{
+			return false;
+		}
+	}
+
+	return true;
