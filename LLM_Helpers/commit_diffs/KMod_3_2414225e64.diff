+bool CvPlayer::isTurnDone() const																			
+{
+	// if this returns true, popups and diplomacy will wait to appear until next turn
+	if (!GC.getGameINLINE().isPbem() && !GC.getGameINLINE().isHotSeat())
+	{
+		return false;
+	}
+	if (!isHuman() )
+	{
+		return true;
+	}
+	if (!isEndTurn())
+	{
+		return false;
+	}
+	return (!isAutoMoves());
