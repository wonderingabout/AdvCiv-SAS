+int CvActionInfo::getMissionData() const		
+{
+
+	if	(
+				(ACTIONSUBTYPE_BUILD == m_eSubType)				||
+				(ACTIONSUBTYPE_RELIGION == m_eSubType)		||
+				(ACTIONSUBTYPE_CORPORATION == m_eSubType)		||
