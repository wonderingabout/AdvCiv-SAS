+void createTestFontString(CvWStringBuffer& szString)
+{
+	int iI;
+	szString.assign(L"!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[�]^_`abcdefghijklmnopqrstuvwxyz\n");
+	szString.append(L"{}~\\������������������������������ޟ�������������������������������������������������������");
