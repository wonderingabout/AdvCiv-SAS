+int CvPlot::calculateCulturePercent(PlayerTypes eIndex) const
+{
+	int iTotalCulture;
+
+	iTotalCulture = countTotalCulture();
+
+	if (iTotalCulture > 0)
+	{
+		return ((getCulture(eIndex) * 100) / iTotalCulture);
