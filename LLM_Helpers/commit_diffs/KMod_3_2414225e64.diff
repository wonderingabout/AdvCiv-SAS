+		else
+		{
+			szString = gDLL->getText("TXT_KEY_TRADE_GOLD_PER_TURN_NUM", AI_maxGoldPerTurnTrade(eOtherPlayer));
+		}
+		break;
+	case TRADE_MAPS:
+		szString = gDLL->getText("TXT_KEY_TRADE_WORLD_MAP_STRING");
+		break;
+	case TRADE_VASSAL:
