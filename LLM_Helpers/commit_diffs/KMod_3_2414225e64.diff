+		if (bOldCleanPower != isCleanPower(eIndex))
+		{
+			GET_TEAM(eIndex).updateCommerce();
+			GET_TEAM(eIndex).updatePowerHealth();
+
+			if (eIndex == GC.getGameINLINE().getActiveTeam())
