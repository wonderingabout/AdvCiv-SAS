+const CvString& CvPopupInfo::getOnFocusPythonCallback() const
+{
+	return m_szOnFocusPythonCallback;
+}
+
+const CvString& CvPopupInfo::getOnClickedPythonCallback() const
+{
+	return m_szOnClickedPythonCallback;
+}
