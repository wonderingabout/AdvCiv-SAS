+
+void CvPlayer::processCivics(CivicTypes eCivic, int iChange)
+{
+	int iI, iJ;
+
+	changeGreatPeopleRateModifier(GC.getCivicInfo(eCivic).getGreatPeopleRateModifier() * iChange);
