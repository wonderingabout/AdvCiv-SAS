+	~TeamWaterPathFinder()
+	{
+		delete m_pAnyWaterFinder;
+		delete m_pShallowWaterFinder;
+	}
+	inline TeamPathFinder<TeamPath::ANY_WATER>& anyWaterFinder()
+	{
