+	{
+		return *m_pShallowWaterFinder;
+	}
+private:
+	TeamPathFinder<TeamPath::ANY_WATER>* m_pAnyWaterFinder;
+	TeamPathFinder<TeamPath::SHALLOW_WATER>* m_pShallowWaterFinder;
+};
