-// For XML loading. Adding 4 byte to derived classes for the vtable pointer.
-template<typename V>
-class CvInfoMap2D
-{
-public:
-	virtual void insert(int iFirstKey, int iSecondKey, V vValue)=0;
-	virtual void finalizeInsertions() {}
-	virtual V getDefault() const=0;
-};
-
-/*	When it comes to template-templates, our MSVC03 compiler has a problem
-	with the DEFAULT non-type param having the type of the V type param
-	declared in the same template param list.
-	Using int for DEFAULT param works around this (I've done so in ScaledNum.h too),
-	but I do want DEFAULT to have type V wherever possible, so that
-	e.g. DEFAULT=200 will cause a compilation error when V=char. So I'm going to
-	define wrapper classes with int DEFAULT only for the sake of the
-	CvInfoEnumMap2D template-template. */
-#define INT_WRAP(M) \
-	template<typename E, typename V, int iDEFAULT = 0> \
-	class M##_t : public M<E, V, static_cast<V>(iDEFAULT)> \
-	{ \
-	public: \
-		M##_t() {} \
-		/* Empty instances are only needed by the 2D map; */ \
-		/* insofar it's convenient that we have these wrappers. */ \
-		M##_t(bool bEmpty) \
-		{ \
-			finalizeInsertions(); \
-		} \
-	}
-
-INT_WRAP(ListEnumMap);
-INT_WRAP(ArrayEnumMap);
-INT_WRAP(ListAndArrayEnumMap);
-
-#undef INT_WRAP
-
-template<
-	typename E1,
-	template<typename, typename, int> class M,
-	typename E2, typename V, int iDEFAULT = 0>
-class CvInfoEnumMap2D : public CvInfoMap2D<V>
-{
-	M<E2,V,iDEFAULT>* m_maps;
-	static V const vDEFAULT = static_cast<V>(iDEFAULT);
-
-public:
-	CvInfoEnumMap2D() : m_maps(NULL) {}
-
-	~CvInfoEnumMap2D()
-	{
-		uninit();
-		getIntArray(static_cast<E2>(0), true);
-	}
-
-	V getDefault() const // override
-	{
-		return vDEFAULT;
-	}
-
-	void finalizeInsertions() // override
-	{
-		if (isAllocated())
-		{
-			for (int i = 0; i < numMaps(); i++)
-			{
-				m_maps[i].finalizeInsertions();
-			}
-		}
-	}
-
-	void insert(int iFirstKey, int iSecondKey, V vValue) // override
-	{
-		if (vValue == vDEFAULT)
-			return;
-		if (!isAllocated())
-			allocateMaps();
-		m_maps[iFirstKey].insert(iSecondKey, vValue);
-	}
-
-	// BtS convention is to put the smaller type (number of maps) in the 2nd argument
-	V get(E2 eSecondKey, E1 eFirstKey) const
-	{
-		if (!isAllocated())
-			return vDEFAULT;
-		FAssertEnumBounds(eFirstKey);
-		FAssertEnumBounds(eSecondKey);
-		return m_maps[eFirstKey].get(eSecondKey);
-	}
-
-	M<E2,V,iDEFAULT> const& getMap(E1 eFirstKey) const
-	{
-		if (!isAllocated())
-		{
-			static M<E2,V,iDEFAULT> emptyMap(true);
-			return emptyMap;
-		}
-		FAssertEnumBounds(eFirstKey);
-		return m_maps[eFirstKey];
-	}
-
-	bool isAnyNonDefault() const
-	{
-		return isAllocated();
-	}
-
-	int const* getIntArray(E2 eSecondKey, bool bFree = false) const
-	{
-		/*	Not terribly efficent b/c we're storing
-			a small array of big maps, whereas BtS was storing
-			a large array of small arrays.
-			No big matter - it's only for game text, it's still not slow,
-			and the static memory gets allocated only once per class.
-			The memory management is a hack job. The caller doesn't need to
-			bother with it though; the callee will clean it up in the destructor.
-			The time during which arrays for two different eSecondKeys are used
-			mustn't overlap - b/c it'll be the same array. */
-		static int* aeiValsPerSecondKey = NULL;
-		if (bFree)
-		{
-			SAFE_DELETE_ARRAY(aeiValsPerSecondKey);
-			return NULL;
-		}
-		if (aeiValsPerSecondKey == NULL)
-			aeiValsPerSecondKey = new int[numMaps()];
-		if (!isAllocated())
-			std::fill_n(aeiValsPerSecondKey, numMaps(), static_cast<int>(vDEFAULT));
-		else
-		{
-			for (int i = 0; i < numMaps(); i++)
-				aeiValsPerSecondKey[i] = static_cast<int>(m_maps[i].getUnsafe(eSecondKey));
-		}
-		return aeiValsPerSecondKey;
-	}
-
-	// <advc.003i> See comments in CvInfoMap
-	void write(FDataStreamBase* pStream) const
-	{
-		// Same inefficient format as used by BtS
-		if (!isAllocated())
-		{
-			for (int i = 0; i < numMaps() * numKeysPerMap(); i++)
-				writeVal<V>(vDEFAULT, pStream);
-			return;
-		}
-		for (int i = 0; i < numKeysPerMap(); i++)
-		{
-			for (int j = 0; j < numMaps(); j++)
-			{
-				writeVal<V>(m_maps[j].getUnsafe(static_cast<E2>(i)), pStream);
-			}
-		}
-	}
-
-	void read(FDataStreamBase* pStream)
-	{
-		for (int i = 0; i < numKeysPerMap(); i++)
-		{
-			for (int j = 0; j < numMaps(); j++)
-			{
-				insert(j, i, readNextVal<V>(pStream));
-			}
-		}
-	} // </advc.003i>
-
-	// <advc.xmldefault> (Not tested)
-	CvInfoEnumMap2D(CvInfoEnumMap2D const& kOther)
-	{
-		assign(kOther);
-	}
-
-	CvInfoEnumMap2D& operator=(CvInfoEnumMap2D const& kOther)
-	{
-		assign(kOther);
-		return *this;
-	}
-
-private:
-	void assign(CvInfoEnumMap2D const& kOther)
-	{
-		if (isAllocated() && !kOther.isAllocated())
-		{
-			uninit();
-			return;
-		}
-		if (!isAllocated() && kOther.isAllocated())
-			allocateMaps();
-		for (int i = 0; i < numMaps(); i++)
-		{
-			m_maps[i] = kOther.m_maps[i];
-		}
-	} // </advc.xmldefault>
-
-	void uninit()
-	{
-		SAFE_DELETE_ARRAY(m_maps);
-	}
-
-	__forceinline E1 numKeysPerMap() const
-	{
-		return getEnumLength(static_cast<E1>(0));
-	}
-
-	__forceinline E2 numMaps() const
-	{
-		return getEnumLength(static_cast<E2>(0));
-	}
-
-	__forceinline bool isAllocated() const
-	{
-		return (m_maps != NULL);
-	}
-
-	void allocateMaps()
-	{
-		FAssert(!isAllocated());
-		m_maps = new M<E2,V,iDEFAULT>[numMaps()];
-	}
-	// <advc.003i> See comments in CvInfoMap
-protected:
-	template<typename T>
-	void writeVal(T tValue, FDataStreamBase* pStream) const
-	{
-		pStream->Write((int)tValue);
-	}
-	template<>
-	void writeVal<bool>(bool bValue, FDataStreamBase* pStream) const
-	{
-		pStream->Write(bValue);
-	}
-	template<typename T>
-	T readNextVal(FDataStreamBase* pStream) const
-	{
-		int iValue;
-		pStream->Read(&iValue);
-		if (sizeof(T) == 1)
-			return static_cast<T>(toChar(iValue));
-		if (sizeof(T) == 2)
-			return static_cast<T>(toShort(iValue));
-		return static_cast<T>(iValue);
-	}
-	template<>
-	bool readNextVal<bool>(FDataStreamBase* pStream) const
-	{
-		bool bValue;
-		pStream->Read(&bValue);
-		return bValue;
-	} // </advc.003i>
-};
 
