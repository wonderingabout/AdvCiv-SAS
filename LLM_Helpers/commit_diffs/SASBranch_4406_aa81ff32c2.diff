+			(2,1): 2.2,
+			(1,2): 4.2,
+			(3,0): 1.6,
+		}),
+		(False, False, 2, {
+			(0,0): 22/6.0,
+			(0,1): 20/7.0,
+		}),
+		(False, False, 4, {
+			(1,1): 31/12.0, # mean of all plots
+		}),
+		(False, True, 3, {
+			(1,1): 74/26.0, # lots of double counting due to wrap-around
+		}),
+	]
+	for wrapX, wrapY, radius, expected_map in tests:
+		m = FloatMap()
