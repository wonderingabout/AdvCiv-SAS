+int CvCity::sanitizeProductionTurns(int iTurns, OrderTypes eOrder, int iData,
+		bool bAssert) const {
+
+	if(iTurns < MAX_INT)
+		return iTurns;
+	FAssert(!bAssert);
+	int r = 1;
