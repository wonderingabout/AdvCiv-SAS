+		0: (6, 4),   # ARENA
+		1: (8, 6),   # DUEL
+		2: (11, 8),  # TINY
+		3: (14, 10), # SMALL
+		4: (17, 12), # STANDARD
+		5: (20, 14), # LARGE
+		SAS_WORLDSIZE_HUGE: (24, 17), # HUGE
+	}
+	return sas_lookup_world_size_with_calibrated_sas(eWorldSize, grid_sizes, SAS_HUGE_CUSTOM_MAX_PLAYERS)
 
