+			if (iCpt <= iLowCpt)
+			{
+				if (getForceSpecialistCount(eArtist) < 1)
+				{
+					changeForceSpecialistCount(eArtist, 1);			
+				}
+			}
+		}
+	}
+	// --- END: SAS hard patch ---
+
 	updateEspionageVisibility(true);
 
 	if (!isDisorder())

