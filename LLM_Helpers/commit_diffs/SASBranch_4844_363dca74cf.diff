@@ -0,0 +1,10 @@
+# <!-- custom: ruff vs code extension which i use as a linter in advciv-sas as per chatgpt/becomingthrough's recommendation anyways etc ; very very useful anyways etc, i have found thanks to it string format missing arguments ("%s %s %d" % (str1, str2) for example anyways etc) for example anyways etc, so i'd recommend using it with these settings as part of advciv-sas or whichever mod you are using but is just a suggestion i mean as you prefer if you have a better option or/and want ot do otherwise hopefulyl helpful but anyways etc anyways etc anyways etc -->
+
+# Enable Ruff linting (blazing fast)
+select = ["E", "F"]           # Run errors (E) and pyflakes warnings (F)
+
+# Ignore specific false-positive or mod-specific rules:
+# F403: 'from module import *' used; can't track undefined names
+# F405: Name may be undefined, or defined from star imports
+# E501: Line too long (we allow longer lines in Civ4 UI scripts)
+ignore = ["F403", "F405", "E501"]  # Allow star imports, undefined names, long lines

