+def _SAS_addSection(listEntries, szHeader, items):
+	# Common helper: header + items, with a blank separator between sections.
+	if not items:
+		return
+	if listEntries:
+		listEntries.append(("", -1))
+	listEntries.append((szHeader, -1))
+	for x in items:
+		listEntries.append(x)
+
