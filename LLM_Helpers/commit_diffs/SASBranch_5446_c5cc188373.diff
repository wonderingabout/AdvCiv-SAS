+def findStartingPlot(argsList):
+	# Unless "One Per Team", use default.
+	userInputContinents = CyMap().getCustomMapOption(0)
+	numTeams = CyGlobalContext().getGame().countCivTeamsAlive()
+	if userInputContinents != 1 or numTeams > 6:
