+			iEastX = int(self.iW * fEastLon) - 1
+			iSouthY = int(self.iH * fSouthLat)
+			iNorthY = int(self.iH * fNorthLat) -1
+			iWidth = iEastX - iWestX + 1
+			iHeight = iNorthY - iSouthY + 1
+
