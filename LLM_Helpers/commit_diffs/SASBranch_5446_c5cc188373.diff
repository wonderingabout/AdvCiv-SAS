+			                           0, 0,
+			                           tinyGrain, 4,
+			                           self.iHorzFlags, self.iTerrainFlags,
+			                           7, 6,
+			                           True, 15,
+			                           -1, False,
+			                           False
+			                           )
+
+		# Add the Large Islands (two fractals each to ensure cohesion).
