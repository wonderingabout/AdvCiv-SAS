+		iNorthY = iH - 2
+	elif (numTeams == 3 or numTeams == 5) and yShiftRoll:
+		iSouthY = int(iH * fSouthLat) + yVar
+		iNorthY = int(iH * fNorthLat) + yVar - 1
+	else:
+		iSouthY = int(iH * fSouthLat)
