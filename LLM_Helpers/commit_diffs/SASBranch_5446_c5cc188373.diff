+	                 7: [0.75, 1.0, 0.5, 1.0]},
+	             12: {0: [0.0, 0.25, 0.0, 0.35],
+	                  1: [0.25, 0.5, 0.0, 0.35],
+	                  2: [0.5, 0.75, 0.0, 0.35],
+	                  3: [0.75, 1.0, 0.0, 0.35],
