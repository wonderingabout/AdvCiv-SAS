diff --git a/CvGameCoreDLL/Project/Makefile b/CvGameCoreDLL/Project/Makefile
index 82f53a5ad..48ad737f8 100644
--- a/CvGameCoreDLL/Project/Makefile
+++ b/CvGameCoreDLL/Project/Makefile
@@ -20,6 +20,8 @@
 #   difficult to associate error messages with a translation unit; but don't need
 #   a slow version of every config.]
 # YOURMOD2 and YOURLOGS (see under "Paths").
+# /Z option for debug builds obtained from Makefile.project, the default being /Zd.
+#   This precludes expression evaluation at runtime, but links much faster than /Z7.
 # PROJECT_Profile_CFLAGS, PROJECT_Debug_CFLAGS, PROJECT_DebugOpt_CFLAGS added to Makefile.project.
 # For selecting a profiler and for balancing speed vs. fidelity of debug builds.
 # Removed unused /DCVGAMECOREDLL_EXPORTS from Debug_DEFINES
@@ -141,9 +143,9 @@ SUBDIRPATH15 = ../
 !ENDIF
 !IF [ECHO PROJECT_Profile_CFLAGS = >> Makefile.project]
 !ENDIF
-!IF [ECHO PROJECT_Debug_CFLAGS = >> Makefile.project]
+!IF [ECHO PROJECT_Debug_CFLAGS = /Zd >> Makefile.project]
 !ENDIF
-!IF [ECHO PROJECT_DebugOpt_CFLAGS = >> Makefile.project]
+!IF [ECHO PROJECT_DebugOpt_CFLAGS = /Z7 >> Makefile.project]
 !ENDIF
 !IF [ECHO PRECOMPILE_DEPENDENCIES = >> Makefile.project]
 !ENDIF
@@ -192,10 +194,10 @@ FILE_DEPENDS = $(TEMP_TARGET_FILES)\depends
 
 #### CFLAGS ####
 GLOBAL_CFLAGS=/MD /GR /Gy /EHsc /Gd /Gm- /Fd"$(Target_PDB)" $(CUSTOM_CFLAGS) $(PROJECT_CFLAGS)
-Debug_CFLAGS=/Z7 /Od /RTC1 $(Debug_DEFINES) $(GLOBAL_CFLAGS) $(PROJECT_Debug_CFLAGS)
+Debug_CFLAGS=/Od /RTC1 $(Debug_DEFINES) $(GLOBAL_CFLAGS) $(PROJECT_Debug_CFLAGS)
 Release_CFLAGS=/O2 /G7 /arch:SSE2 $(Release_DEFINES) $(GLOBAL_CFLAGS)
 Final_Release_CFLAGS=$(Release_CFLAGS) /GL
-Debug_Opt_CFLAGS=$(Release_CFLAGS) /Z7 $(PROJECT_DebugOpt_CFLAGS)
+Debug_Opt_CFLAGS=$(Release_CFLAGS) $(PROJECT_DebugOpt_CFLAGS)
 
 PRECOMPILE_CFLAGS1 = /Yu"
 PRECOMPILE_CFLAGS2 = CvGameCoreDLL.h" /Fp"$(Target_PCH)"

diff --git a/CvGameCoreDLL/Project/Makefile.project b/CvGameCoreDLL/Project/Makefile.project
index be6d3e51c..6840bcbcc 100644
--- a/CvGameCoreDLL/Project/Makefile.project
+++ b/CvGameCoreDLL/Project/Makefile.project
@@ -1,8 +1,24 @@
 SOURCE_DIR = ..
 # Stricter warnings. The code editor (.vcxproj) uses /W3 though (by default).
+# PragmaWarnings.h disables some warnings that are too strict.
 PROJECT_CFLAGS = /WX /W4
-# Allow inline expansion of functions with an inline keyword even for debug builds
-PROJECT_Debug_CFLAGS = /Ob1
+
+# Ob1: Allow inline expansion of functions with an inline keyword even for debug builds
+# Replace Zd with Z7 to include symbolic debugging info in object files, which allows
+#   expression evaluation at runtime but takes much longer to link.
+# Zi (symbols in pdb file) also links fast but can't be used with the parallelized
+#   Debug-fast config.
+PROJECT_Debug_CFLAGS = /Ob1 /Zd
+
+# Should use the extra flags for debugging optimized builds (i.e. when debugging
+# errors that aren't reproducible with non-optimizing debug builds). Replacing /O2
+# with just e.g. /Oi /Ot /Ob1 is also worth a try, or a debug build without /RTC1;
+# that would have to be done through the actual Makefile.
+PROJECT_DebugOpt_CFLAGS = /Z7 #/DFASSERT_ENABLE /Oy-
+# Can use whole-program optimization along with debug symbols; it's just slow to compile.
+# (But not suitable for profiling.)
+#PROJECT_DebugOpt_CFLAGS = /GL
+
 # DLL-internal profiler: /DUSE_INTERNAL_PROFILER
 # Time Stamp Counter profiler: /DUSE_TSC_PROFILER
 # External profiler, e.g. Very Sleepy: No profile flags needed; profile builds always use Z7.
@@ -10,14 +26,8 @@ PROJECT_Debug_CFLAGS = /Ob1
 # The Auto Play flag disables graphics updates known to be rare and costly b/c they may
 #   skew profiling of the DLL. So far only affects map trades involving the active player.
 PROJECT_Profile_CFLAGS = /DPROFILE_AI_AUTO_PLAY
+
+# Necessary for this project
 PROJECT_LDFLAGS = /DEF:CvGameCoreDLL.def
+# (none)
 PRECOMPILE_DEPENDENCIES = 
-# Should use these extra flags for debugging (i.e. when debugging errors that
-# aren't reproducible with non-optimizing debug builds). Replacing /O2
-# with just e.g. /Oi /Ot /Ob1 is also worth a try, or a debug build without /RTC1;
-# that would have to be done through the actual Makefile.
-#PROJECT_DebugOpt_CFLAGS = /DFASSERT_ENABLE /Oy-
-# Can use whole-program optimization along with debug symbols; it's just slow to compile.
-# (But not recommended for profiling with Very Sleepy; I've seen it e.g. claim
-# that _alldiv calls all sorts of GameCoreDLL functions.)
-#PROJECT_DebugOpt_CFLAGS = /GL

