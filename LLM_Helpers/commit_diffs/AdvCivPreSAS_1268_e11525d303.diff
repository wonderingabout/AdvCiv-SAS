+							plot.setPlotType(PlotTypes.PLOT_HILLS, True, True)
+							tm.pData[ii] = mc.HILLS
+							break
+			#possibly changed so checked again
+			if plot.isPeak() and plot.isWOfRiver():
+				xx = x + 1
+				for yy in range(y - 1, y + 2):
+					ii = GetIndex(xx, yy)
+					if ii >= 0:
