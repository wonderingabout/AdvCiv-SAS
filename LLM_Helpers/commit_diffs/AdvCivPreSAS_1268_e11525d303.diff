+						continue
+					# <advc.021b> Don't place the cradle of civilization in the Tundra
+					if plot.area().getNumTiles() - plot.getLatitude() < 25 or plot.getLatitude() > 55:
+						continue # </advc.021b>
+					food, value = sf.getCityPotentialValue(x, y)
