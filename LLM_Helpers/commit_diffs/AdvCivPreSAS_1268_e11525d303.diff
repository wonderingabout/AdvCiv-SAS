+void RiseFall::handleCivSelection(PlayerTypes selectedCiv) {
+
+	int pos = getCurrentChapter();
+	if(pos < 0) {
+		FAssert(pos >= 0)
+		return;
+	}
+	if(getCivChapter(selectedCiv) >= 0)
+		chapters[pos]->setRepeat(true);
+	chapters[pos]->setCiv(selectedCiv);
+}
