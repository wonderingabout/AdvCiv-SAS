+					drainList    = list()
+					nonDrainList = list()
+					self.flowMap[i] = mc.L
+					ii = GetIndex(x, y + 1)
+					if ii >= 0 and self.averageHeightMap[ii] < lowestAlt:
+						drainList.append(mc.N)
