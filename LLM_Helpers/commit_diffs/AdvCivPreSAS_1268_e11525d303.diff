+		circlePointList.append(CirclePoint(xCenter + x, yCenter - y))
+		circlePointList.append(CirclePoint(xCenter - x, yCenter - y))
+		circlePointList.append(CirclePoint(xCenter + y, yCenter + x))
+		circlePointList.append(CirclePoint(xCenter - y, yCenter + x))
