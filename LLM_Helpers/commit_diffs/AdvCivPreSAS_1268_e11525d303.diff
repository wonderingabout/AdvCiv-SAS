+void RiseFall::welcomeToNextChapter(int pos) {
+
+	FAssert(pos > 0);
+	RFChapter& ch = *chapters[pos];
+	setPlayerName();
+	CvPlayer& p = GET_PLAYER(ch.getCiv());
+	centerCamera(p.getID());
+	abandonPlans(p.getID()); // Also tries to move the camera
+	showDawnOfMan();
+	showDoW();
+	showQuests();
+	offLimits.clear();
+	updateOffLimits();
+}
