+
+	def getLowestNeighborAltitude(self, x, y):
+		lowest = 1.0
+		for direction in range(1, 5):
+			xx, yy = GetNeighbor(x, y, direction)
+			ii = GetIndex(xx, yy)
+			if ii >= 0 and self.averageHeightMap[ii] < lowest:
+				lowest = self.averageHeightMap[ii]
