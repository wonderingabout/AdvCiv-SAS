+		 chapters. Recommended: 8 turns. Mustn't be negative. Slightly adjusted
+		 by the game based on game speed. -->
+	<Define>
+		<DefineName>RF_INTERLUDE_LENGTH_BASE</DefineName>
+		<iDefineIntVal>8</iDefineIntVal>
+	</Define>
+	<!-- Can use this to give chapters unequal (shifting) length. A negative
+		 value prolongs early chapters and shortens later chapters; a positive
+		 value does the opposite. The absolute value can be at most 75.
+		 Recommended: 0, i.e. uniform chapter lengths. -->
+	<Define>
+		<DefineName>RF_CHAPTER_LENGTH_SHIFT_PERCENT</DefineName>
