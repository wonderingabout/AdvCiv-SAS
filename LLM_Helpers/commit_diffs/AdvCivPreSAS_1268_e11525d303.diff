+class Plate:
+	def __init__(self, ID, seedX, seedY):
+		self.ID    = ID
+		self.seedX = seedX
+		self.seedY = seedY
+		self.isOnMapEdge = False
+		self.raiseOnly   = False
+		self.angle = (PRand.random() * 360) - 180
+		self.NW = 0
+		self.NE = 1
+		self.SE = 2
+		self.SW = 3
