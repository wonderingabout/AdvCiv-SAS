+	def GetQuadrant(self):
+		if self.seedY < mc.hmHeight / 2:
+			if self.seedX < mc.hmWidth / 2:
+				return self.SW
+			else:
+				return self.SE
+		else:
+			if self.seedX < mc.hmWidth / 2:
+				return self.NW
+			else:
+				return self.NE
