+void RiseFall::computeEligibleCivs(vector<PlayerTypes>& r, bool allowRepeat) const {
+
+	for(int i = 0; i < MAX_CIV_PLAYERS; i++) {
+		PlayerTypes civId = (PlayerTypes)i;
+		if(isEligible(civId, allowRepeat))
+			r.push_back(civId);
