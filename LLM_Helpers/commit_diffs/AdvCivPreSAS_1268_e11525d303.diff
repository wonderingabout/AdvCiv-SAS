+			i = GetIndex(x, y)
+			if em.data[i] < em.seaLevelThreshold:
+				em.data[i] = em.seaLevelThreshold - 0.000001
+	#smaller lakes need to be filled in again because the map
+	#shrinker sometimes creates lakes.
+	am = AreaMap(mc.width, mc.height, True, True)
