+	def getCirclePoints(self, xCenter, yCenter, radius):
+		circlePointList = list()
+		x = 0
+		y = radius
+		p = 1 - radius
+		self.addCirclePoints(xCenter, yCenter, x, y, circlePointList)
+		while (x < y):
+			x += 1
+			if p < 0:
+				p += 2 * x + 1
+			else:
+				y -= 1
+				p += 2 * (x - y) + 1
+			self.addCirclePoints(xCenter, yCenter, x, y, circlePointList)
+		return circlePointList
