--- /dev/null
+++ b/CvGameCoreDLL/CvUnitList.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#ifndef CIV4_UNIT_LIST_H
+#define CIV4_UNIT_LIST_H
+
+#include "FLTALoopCounter.h"
+#include "FFreeListTrashArray.h"
