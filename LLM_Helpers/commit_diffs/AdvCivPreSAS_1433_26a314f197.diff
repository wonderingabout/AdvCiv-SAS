+<?xml version="1.0" encoding="ISO-8859-1"?>
+<!-- advc.076: Help text for the player options menu; some new, some revised.
+	 For revised text, I've mostly left the Romance-language translations
+	 alone. -->
+<Civ4GameText>
+
+	<!-- From CIV4GameTextInfos.xml -->
+	<!-- Was "Game", but the options on the Custom Game screen are also
+		 game options. The options for rival moves and recommendations don't
+		 really fit under "Controls". "UI"?
+		 I'm quite happy with German "Bedienung". -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_GAME</Tag>
+		<English>Controls</English>
+		<French>Jeu</French>
+		<German>Bedienung</German>
+		<Italian>Partita</Italian>
+		<Spanish>Juego</Spanish>
+	</TEXT>
+	<!-- New key based on TXT_KEY_OPTIONS_SCREEN_PROFILES.
+		 There's more space now for the panel title. -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_PROFILES_TITLE</Tag>
+		<English>Option Profiles</English>
+		<French>Profils</French>
+		<German>Optionsprofile</German>
+		<Italian>Profili</Italian>
+		<Spanish>Perfiles</Spanish>
+	</TEXT>
+	
+	<!-- Based on TXT_KEY_OPTIONS_NEED_TO_RESTART in CIV4GameTextInfos.xml.
+		 Romance-language translations just copied from there. -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_NEED_TO_RELOAD</Tag>
+		<English>Need to load a savegame, exit to main menu or restart for changes to take effect.</English>
+		<French>Le programme doit &#234;tre relanc&#233; pour que les modifications soient prises en consid&#233;ration.</French>
+		<German>Neustart, R�ckkehr ins Hauptmen� oder Laden eines Spielstands erforderlich, damit die �nderung wirksam wird.</German>
+		<Italian>Il programma deve essere riavviato prima che i cambiamenti abbiano effetto</Italian>
+		<Spanish>Hay que reiniciar el programa para que los cambios surtan efecto</Spanish>
+	</TEXT>
+	
+	<!-- New: Headings -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_GENCONTROL</Tag>
+		<English>Turn Sequence</English>
+		<French>G&#233;n&#233;ral</French>
+		<German>Rundenablauf</German>
+		<Italian>Generale</Italian>
+		<Spanish>Generales</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_UNITCONTROL</Tag>
+		<English>Unit Controls</English>
+		<French>Unit�s</French>
+		<German>Einheiten-Steuerung</German>
+		<Italian>Unit&#224;</Italian>
+		<Spanish>Unidades</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_RIVALS</Tag>
+		<English>Rival Moves</English>
+		<French>Mouvements rivaux</French>
+		<German>Gegnerische Z�ge</German>
+		<Italian>Movimenti di rivali</Italian>
+		<Spanish>Movimientos de rivales</Spanish>
+	</TEXT>
+	<!-- Based on TXT_KEY_COMMAND_STOP_AUTOMATION (CIV4GameTextInfos.xml) -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_AUTOMATE</Tag>
+		<English>Automation</English>
+		<French>Automatisation</French>
+		<German>Automatisierung</German>
+		<Italian>Automazione</Italian>
+		<Spanish>Automatizaci&#243;n</Spanish>
+	</TEXT>
+	<!-- Based on TXT_KEY_PLAYER_OPTION_NO_UNIT_RECOMMEND
+		 (CIV4GameTextInfos.xml) -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_RECOMMEND</Tag>
+		<English>Recommendations</English>
+		<French>Recommandations</French>
+		<German>Empfehlungen</German>
+		<Italian>Raccomandazioni</Italian>
+		<Spanish>Recomendaciones</Spanish>
+	</TEXT>
+	<!-- Since the options are all negative ... -->
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_ANIMATIONS</Tag>
+		<English>Disable Animations</English>
+		<French>Animations</French>
+		<German>Animationen deaktivieren</German>
+		<Italian>Animazioni</Italian>
+		<Spanish>Animaciones</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_VISAIDS</Tag>
+		<English>Visual Aids</English>
+		<French>Supports visuels</French>
+		<German>Sichthilfen</German>
+		<Italian>Ausili visivi</Italian>
+		<Spanish>Ayudas visuales</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_OPTIONS_SCREEN_HEADING_UNITGFX</Tag>
+		<English>Unit Graphics</English>
+		<French>Unit�s</French>
+		<German>Einheiten-Grafiken</German>
+		<Italian>Unit&#224;</Italian>
+		<Spanish>Unidades</Spanish>
