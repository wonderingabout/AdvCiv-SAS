+// <advc.314>
+bool CvPlayer::isGoodyTech(TechTypes techId, bool bProgress) const {
+
+	CvTechInfo& t = GC.getTechInfo(techId);
+	if(!bProgress && !t.isGoodyTech())
+		return false;
+	if(bProgress && t.getEra() >= 4)
+		return false;
+	return canResearchBulk(techId, false, true);
+}
