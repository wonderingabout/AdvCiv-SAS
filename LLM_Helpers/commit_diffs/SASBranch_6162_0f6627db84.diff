+        return [], None
+    args = ["log", "--no-color", "--reverse", "--topo-order", "--format=%H%x1f%P%x1f%s%x1e", *revisions, f"^{exclude_revision}"]
+    raw, error = run_git(repo_root, *args)
+    if raw is None:
+        return [], error
+    commits: list[dict[str, str]] = []
+    for record in raw.split("\x1e"):
