 		CvEventReporter::getInstance().genericEvent("sasBattleHistoryCombatDetails", pyArgsSASBattleDetails.makeFunctionArgs());
 	}
 	int iAttackerKillOdds = iDefenderOdds * (100 - withdrawalProbability()) / 100;

