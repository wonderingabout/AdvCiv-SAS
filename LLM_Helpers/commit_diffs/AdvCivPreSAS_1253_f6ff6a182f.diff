+			continue;
+		// No vassal-related forgiveness when war success high
+		delta = std::min(0, delta + ws / member.warSuccessAttitudeDivisor());
+		for(int j = 0; j < MAX_CIV_PLAYERS; j++) {
+			CvPlayer const& enemyMember = GET_PLAYER((PlayerTypes)j);
