+	<Define>
+		<DefineName>SHOW_TOP_CIVS</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
+
+    <!-- [advc.107]
+		 Starting from this game era, the AI keeps an extra defender in all of 
+		 its cities. The era codes are:
