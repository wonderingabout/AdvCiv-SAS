+		 is small (now that the AI doesn't patrol its lands anymore). -->
+	<Define>
+		<DefineName>SHOW_FRIENDLY_SOLO_MOVES</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
