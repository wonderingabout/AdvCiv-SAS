+		 void assignStartPoints();
+		 void assignStartingPlot(CvPlot* plot);
+
+	private:
+		int adjust(int pts);
+
+		PlayerTypes civId;
+		int startPoints_c, startPoints_a;
+		bool actualPointsDone;
+		static int foundingPrice;
+		int d;
+	};
+};
