+	<Define>
+		<DefineName>ENABLE_HOTKEY_SHOW_FRIENDLY_MOVES</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
+
+	<!-- [advc.102]
+		 If set to 0, this one filters out moves of units with the following
