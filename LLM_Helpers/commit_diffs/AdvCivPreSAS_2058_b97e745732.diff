 int CvPlayer::cultureConvertedUponCityTrade(CvPlot const& kCityPlot, CvPlot const& kPlot,
-	PlayerTypes eOldOwner) const
+	PlayerTypes eOldOwner, PlayerTypes eNewOwner, bool bIgnorePriority) const
 {
