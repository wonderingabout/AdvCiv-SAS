diff --git a/Assets/XML/GlobalDefines_advc.xml b/Assets/XML/GlobalDefines_advc.xml
index 164baafa7..6598e643b 100644
--- a/Assets/XML/GlobalDefines_advc.xml
+++ b/Assets/XML/GlobalDefines_advc.xml
@@ -1182,4 +1182,16 @@
 		<iDefineIntVal>20</iDefineIntVal>
 	</Define>
 
+	<!-- advc.045: A value of 1 means that 3D models of all buildings in
+		 revealed rival cities are shown on the main map (as in BtS) and that
+		 the UI in general treats such buildings as open information.
+		 A value of 0 (recommended) treats rival buildings as secret unless
+		 the active (human) player has a unit in the city tile or the building
+		 can be inferred from tile yields (e.g. Lighthouse) or city
+		 defense modifier (e.g. Walls). -->
+	<Define>
+		<DefineName>TREAT_REVEALED_BUILDINGS_AS_VISIBLE</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
+
 </Civ4Defines>

diff --git a/CvGameCoreDLL/CvCity.cpp b/CvGameCoreDLL/CvCity.cpp
index 05c13dcc2..872d126b1 100644
--- a/CvGameCoreDLL/CvCity.cpp
+++ b/CvGameCoreDLL/CvCity.cpp
@@ -11714,6 +11714,11 @@ bool CvCity::isAllBuildingsVisible(TeamTypes eTeam, bool bDebug) const
 {
 	if (bDebug && GC.getGame().isDebugMode())
 		return true;
+	if (GC.getDefineBOOL(CvGlobals::TREAT_REVEALED_BUILDINGS_AS_VISIBLE) &&
+		isRevealed(eTeam, bDebug))
+	{
+		return true;
+	}
 	return (getTeam() == eTeam || getPlot().isInvestigate(eTeam) ||
 			getPlot().plotCheck(NULL, -1, -1, NO_PLAYER, eTeam) > 0 != NULL);
 }

