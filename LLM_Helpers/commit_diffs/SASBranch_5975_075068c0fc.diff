-	<!-- custom: Runtime cache logging only: 0 = don't dump to log, 1 = dump a PythonDbg.log block for the old manual predump refresh path (Note: not necessary to enable if you use the new script-based way of regenerating the predump). (ChatGPT-5.5); Long_Comments_XML.txt #192 -->
+	<!-- custom: Runtime cache logging only: 0 = don't dump to log, 1 = dump a PythonDbg.log block for the old manual predump refresh path. Normally leave disabled; the GitHub refresh bot or local aip_predump_values.py write mode can refresh the predump outside Civ4 without this log dump. (ChatGPT-5.5); Long_Comments_XML.txt #192 -->
 	<Define>
 		<DefineName>SAS_SEVOPEDIA_LEADER_AI_PERSONALITY_CACHE_DUMP_TO_LOG</DefineName>
