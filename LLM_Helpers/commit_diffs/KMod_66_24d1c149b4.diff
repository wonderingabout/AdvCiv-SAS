+			iTempValue *= ((AI_avoidScience()) ? 6 : 2); 
+		} 
+		else if (iI == YIELD_COMMERCE) 
+		{ 
+			iTempValue *= ((AI_avoidScience()) ? 2 : 4);
+			iTempValue /= 3;
+		}
+
+		iTempValue *= AI_yieldWeight((YieldTypes)iI);
