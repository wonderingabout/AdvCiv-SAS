+		AI_roundTradeValBounds(iTradeVal, true, iLower, iUpper);
+		if (iTradeVal != iTmpVal)
+			iTmpVal = iTradeVal - GC.getDefineINT(CvGlobals::DIPLOMACY_VALUE_REMAINDER);
+	}
+	if (iTmpVal >= iLower && iTmpVal <= iUpper)
+			iTradeVal = iTmpVal;
+}
