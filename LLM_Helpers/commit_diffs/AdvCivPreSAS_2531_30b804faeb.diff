+	int const x = GC.getDefineINT("GLOBAL_WARMING_PROB") * getGlobalWarmingIndex() /
+			std::max(1, GC.getMap().getLandPlots() * 4 *
+			GC.getInfo(getGameSpeedType()).getVictoryDelayPercent());
