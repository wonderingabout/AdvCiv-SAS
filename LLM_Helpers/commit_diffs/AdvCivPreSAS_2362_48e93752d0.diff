+bool CvPlot::canEverFound() const
+{
+	if (isImpassable())
+		return false;
+	// advc.opt: Water check moved up
+	/*  UNOFFICIAL_PATCH, Bugfix, 02/16/10, EmperorFool & jdog5000:
