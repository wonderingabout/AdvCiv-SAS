+#endif
+bool CvTechInfo::read(CvXMLLoadUtility* pXML)
+{
+	CvString szTextVal;
+	if (!CvInfoBase::read(pXML))
+		return false;
+
+	pXML->GetChildXmlValByName(szTextVal, "Advisor");
