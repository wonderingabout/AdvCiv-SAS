+bool CvBuildingInfo::read(CvXMLLoadUtility* pXML)
+{
+	if (!CvHotkeyInfo::read(pXML))
+		return false;
+
+	CvString szTextVal;
+
+	pXML->GetChildXmlValByName(szTextVal, "BuildingClass");
+	m_iBuildingClassType = pXML->FindInInfoClass(szTextVal);
