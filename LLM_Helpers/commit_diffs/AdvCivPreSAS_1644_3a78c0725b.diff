+void CvCivicInfo::read(FDataStreamBase* stream)
+{
+	CvInfoBase::read(stream);
+	uint uiFlag=0;
+	stream->Read(&uiFlag);
+
+	stream->Read(&m_iCivicOptionType);
+	stream->Read(&m_iAnarchyLength);
+	stream->Read(&m_iUpkeep);
+	stream->Read(&m_iAIWeight);
