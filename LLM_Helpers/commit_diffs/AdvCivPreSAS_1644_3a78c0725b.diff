+CvTerrainPlaneInfo::CvTerrainPlaneInfo()
+// <kmodx>
+: m_bVisible(false),
+  m_bGroundPlane(false),
+  m_fMaterialAlpha(0.0f),
+  m_fCloseAlpha(0.0f),
+  m_BaseTextureScaleU(0.0f),
+  m_BaseTextureScaleV(0.0f),
+  m_fURate(0.0f),
+  m_fVRate(0.0f),
+  m_fZHeight(0.0f),
+  m_eFogType(FOG_TYPE_NONE)
+// </kmodx>
+{}
