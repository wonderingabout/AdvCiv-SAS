+					for (int j = 0; j < iNumSibs; j++)
+					{
+						m_paszSymbolPath[j] = szTextVal;
+						if (!pXML->GetNextXmlVal(szTextVal))
+							break;
+					}
+
+					gDLL->getXMLIFace()->SetToParent(pXML->GetXML());
+				}
+			}
