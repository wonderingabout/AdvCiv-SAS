diff --git a/Assets/XML/Text/AdvCiv-SAS_Sevopedia_Lengthy.xml b/Assets/XML/Text/AdvCiv-SAS_Sevopedia_Lengthy.xml
index 0f9653e53..1c8f7bb58 100644
--- a/Assets/XML/Text/AdvCiv-SAS_Sevopedia_Lengthy.xml
