--- /dev/null
+++ b/Assets/XML/Text/XXL_World_SAS_Modified.xml
@@ -0,0 +1,70 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- custom: The Mod XXL World (https://forums.civfanatics.com/resources/xxl-world-bts.6708/) is as of now now implemented into AdvCiv-SAS, with the help of GPT-5.2-Codex thanks. These are where TXT KEYs that are most relevant to XXL World Mod are located in AdvCiv-SAS.
+Note: AdvCiv-SAS uses a modified version of the XXL World with different World Size names (adjusted by GPT-Codex-5.2 for AdvCiv-SAS thanks).
+Note 2 : XLL and bigger world sizes are recommended to be played with the 48 civs DLL, and they require the a > MAX_CIV_PLAYERS civs DLL to be able able to play with all players the world size supports. Since we only provided the 48 civs DLL (as of now CvGameCoreDLL_48_civs_DLL.dll, see docs for details on how to use it) in AdvCiv-SAS, to simplify, we explain it as requiring the 48 civs DLL for SAS24+ world sizes, but a 24 civs DLL or 96 civs DLL could just as well respectively for SAS24 or SAS40 world sizes for example. -->
+<Civ4GameText>
+	<TEXT>
+		<Tag>TXT_KEY_MAIN_MENU_SELECT_WORLD_SETUP</Tag>
+		<English>WORLD SIZE (Base/48 civs DLL)</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_MAIN_MENU_SELECT_WORLD_SIZE_TITLE</Tag>
+		<English>WORLD SIZE (Base/48 civs DLL)</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_MENU_SIZE</Tag>
+		<English>Size (Base/48 civs):</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_PEDIA_WORLD_SIZES_CHART_RECOMMENDED_DLL_FIELD</Tag>
+		<English>Recommended DLL</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_PEDIA_WORLD_SIZES_CHART_BASE_DLL</Tag>
+		<English>Base</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_PEDIA_WORLD_SIZES_CHART_48_CIVS_DLL</Tag>
+		<English>48 civs</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_ARENA</Tag>
+		<English>Arena</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS24</Tag>
+		<English>SAS24</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS32</Tag>
+		<English>SAS32</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS40</Tag>
+		<English>SAS40</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS48</Tag>
+		<English>SAS48</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_ARENA_HELP</Tag>
+		<English>An extra-small World Size smaller than Base AdvCiv's Duel World Size. Requires the 48 civs DLL for default player counts.</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS24_HELP</Tag>
+		<English>An extra-large World Size sized for about 24 civs. Requires the 48 civs DLL for default player counts.</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS32_HELP</Tag>
+		<English>A massive World Size sized for about 32 civs. Requires the 48 civs DLL for default player counts.</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS40_HELP</Tag>
+		<English>A huge World Size sized for about 40 civs. Requires the 48 civs DLL for default player counts.</English>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_WORLD_SAS48_HELP</Tag>
+		<English>A huge World Size sized for about 48 civs. Requires the 48 civs DLL for default player counts.</English>
+	</TEXT>
+</Civ4GameText>

