@@ -116,6 +116,11 @@ Created as part of AdvCiv-SAS improvements
 
 
 
+	<!-- custom: disable the Sevopedia Leader custom item-list width when screen width is above this threshold (strictly >). Set to <=0 to keep custom width always enabled. (GPT-5.3-Codex). This is because at higher resolutions we have enough width to accomodate an enlarged AI Personality Panel, so we don't need to reduce width of the item bar anymore. Note: AI Personality panel is still expanded when text is upscaled (so it is not cramped) regardless of this item bar setting -->
+	<Define>
+		<DefineName>SAS_SEVOPEDIA_LEADER_ITEMS_NO_REDUCE_MIN_WIDTH</DefineName>
+		<iDefineIntVal>2560</iDefineIntVal>
+	</Define>
 	<!-- custom: Sevopedia Leader item-list width by SAS_UI_FONT_LABEL (1..4). For upscaled fonts we reclaim width from the leader item list and use it to enlarge/rebalance Leader AI panel columns. <=0 falls back to default item width. (GPT-5.3-Codex) -->
 	<Define>
 		<DefineName>SAS_SEVOPEDIA_LEADER_ITEMS_WIDTH_FONT_1</DefineName>
@@ -136,6 +141,31 @@ Created as part of AdvCiv-SAS improvements
 
 
 
+	<!-- custom: Tech Chooser (i.e. Technology Advisor) low-res scoreboard swap threshold (in pixels).
+	<= 0: hard disable; > 0: if current screen width is below this threshold, Tech Chooser uses the alternate low-res scoreboard margin below to gain tree width (more columns). A very high value like 9999 effectively always applies on current displays.
+	Example: a value of 2560 means the right space alternate value applies for widths below 2560*1440 (i.e. 1440p) (e.g., for 1920*1080 (i.e. 1080p)).
+	(GPT-5.3-Codex) -->
+	<Define>
+		<DefineName>SAS_CV_TECH_CHOOSER_LOW_RES_SCOREBOARD_SWAP_WIDTH</DefineName>
+		<iDefineIntVal>2560</iDefineIntVal>
+	</Define>
+	<!-- custom: Tech Chooser alternate right-side reserved space for scoreboard when low-res swap is active.
+	Lower value => wider tech tree and more chance to fit one extra column at low resolution.
+	Higher value => preserves more scoreboard/map area.
+	This is mainly useful on lower resolutions where reclaiming some scoreboard space can make one more tech-tree column visible.
+	Use 0 for maximum squeeze during low-res mode. (GPT-5.3-Codex); for example at 1080p a value of 206 allows to show exactly one more technology advisor column -->
+	<Define>
+		<DefineName>SAS_CV_TECH_CHOOSER_RIGHT_SPACE_FOR_SCOREBOARD_LOW_RES</DefineName>
+		<iDefineIntVal>206</iDefineIntVal>
+	</Define>
+	# <!-- custom: optional low-res top-space replacement paired with the low-res width swap; useful to keep map-view advisor buttons accessible when Tech Chooser is widened. (GPT-5.3-Codex) -->
+	<Define>
+		<DefineName>SAS_CV_TECH_CHOOSER_TOP_SPACE_FOR_TECH_BAR_LOW_RES</DefineName>
+		<iDefineIntVal>52</iDefineIntVal>
+	</Define>
+
+
