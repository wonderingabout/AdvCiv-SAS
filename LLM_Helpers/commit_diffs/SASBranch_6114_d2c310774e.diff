+		<DefineName>SAS_MAP_STANDARD_JUNGLE_PERCENT</DefineName>
+		<iDefineIntVal>80</iDefineIntVal>
+	</Define>
+	<!-- custom: Base Jungle grain; higher values produce smaller Jungle patches. Both BTS and AdvCiv use 5; WorldInfo FeatureGrainChange is added afterward, and explicit map-script jungle_grain remains independent. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_STANDARD_JUNGLE_GRAIN</DefineName>
+		<iDefineIntVal>5</iDefineIntVal>
+	</Define>
+	<!-- custom: Base Forest grain; higher values produce smaller Forest patches. Both BTS and AdvCiv use 6; WorldInfo FeatureGrainChange is added afterward, and explicit map-script forest_grain remains independent. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_STANDARD_FOREST_GRAIN</DefineName>
+		<iDefineIntVal>6</iDefineIntVal>
+	</Define>
+	<!-- custom: Default iForestPercent threshold for the shared FeatureGenerator; a lower value produces more Forest. AdvCiv uses 57 to compensate for reduced starting-position Forest normalization; use 60 for BTS. A map script that supplies its own threshold keeps that value. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_STANDARD_FOREST_PERCENT</DefineName>
+		<iDefineIntVal>57</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 uses AdvCiv's randomized river-source traversal and symmetrical river-direction scoring with slightly stronger attraction to water, which made rivers somewhat shorter. 0 restores the retained BTS traversal and direction-scoring paths. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_RIVER_ROUTING_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- custom: Random upper bound added to each river-direction score; a larger value makes routing less predictable. AdvCiv changed the BTS value from 10 to 20 to add randomness without materially changing the score scale. Default 20 preserves AdvCiv-SAS; use 10 with SAS_MAP_ADVCIV_RIVER_ROUTING_ENABLE=0 for the complete BTS-style routing profile. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_RIVER_DIRECTION_RANDOMNESS</DefineName>
+		<iDefineIntVal>20</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 randomizes the order of resource types that share an XML PlacementOrder, preventing later XML entries from always losing on crowded maps. 0 restores BTS XML-order tie resolution. The ordinal loop itself remains optimized because processing only PlacementOrder values that exist is functionally equivalent and also supports values above the number of bonus types. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_BONUS_TIE_RANDOMIZATION_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 uses AdvCiv's OneArea resource distribution: prefer landmasses with suitable tiles, reduce the influence of area size as the target is approached, and limit the first allocation on each area so excess copies can spread elsewhere. 0 restores BTS selection by total area size divided by the number of unique resource types already assigned there, allowing stronger concentration on one landmass. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_ONE_AREA_BONUS_DISTRIBUTION_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 uses AdvCiv's less-dense clustering: prevent more than two adjacent copies, keep clustered precious-resource groups apart, randomize a circular GroupRange, and reduce GroupRand after each placed copy. 0 restores BTS's fixed-order square GroupRange with the full XML GroupRand chance for every eligible tile. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_BONUS_CLUSTERING_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 uses AdvCiv's nonlinear PercentPerPlayer component: equal to BTS at 8 players, somewhat higher below 8, and lower above 8. 0 restores BTS linear player-count scaling. This is independent of the eligible-tile component controlled by SUBLINEAR_BONUS_QUANTITIES in GlobalDefines_advc.xml. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_BONUS_PLAYER_COUNT_SCALING_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- custom: Relative probability for a desert candidate to receive a lake compared with other eligible terrain; the algorithm compensates to preserve the overall expected lake count. AdvCiv uses 25 to make desert lakes rarer; BTS used 100. Use a positive value. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_DESERT_LAKE_RELATIVE_PERCENT</DefineName>
+		<iDefineIntVal>25</iDefineIntVal>
+	</Define>
+	<!-- custom: 0 preserves AdvCiv's rule that random lakes cannot replace Peaks. 1 restores BTS behavior allowing an otherwise eligible Peak to become a lake. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_LAKE_PEAK_REPLACEMENT_ENABLE</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
+	<!-- custom: 1 uses AdvCiv's randomized standard FeatureGenerator traversal, removing fixed coordinate-order bias for bNoAdjacent features such as Oasis. 0 restores BTS coordinate-order traversal. Custom map scripts that override feature generation retain their own behavior. (GPT-5.6-Sol) -->
+	<Define>
+		<DefineName>SAS_MAP_ADVCIV_FEATURE_PLACEMENT_ORDER_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+
+
+
 	<!-- custom: comma-separated map script names (optional .py/path tolerated) treated as land-heavy by DLL cache (GPT-5.3-Codex) -->
 	<Define>
 		<DefineName>SAS_MAP_SCRIPT_NAMES_LAND_HEAVY</DefineName>

