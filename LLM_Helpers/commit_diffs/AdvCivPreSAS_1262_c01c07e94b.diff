+	WarEvalParameters params(we.getTeam(), TEAMID(theyId), silentReport);
+	WarEvaluator eval(params);
+	double u = eval.evaluate(WARPLAN_LIMITED, 5) - 5; // minus 5 for goodwill
+	if(u >= 0)
+		return false;
+	return utilityToTradeVal(-u) < tradeVal;
