+// <!-- custom: per-era leader art lookup (optional). Empty string = not set. (Claude code Opus 4.7) -->
+const TCHAR* CvLeaderHeadInfo::getEraArtDefineTag(EraTypes eEra) const
+{
+	if (m_paszEraArtDefineTags == NULL || eEra == NO_ERA)
