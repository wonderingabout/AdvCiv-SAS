+
+int AIFoundValue::applyCultureModifier(CvPlot const& p, int iPlotValue, int iCultureModifier,
+	bool bShare) const
+{
+	int r = iPlotValue;
+	// K-Mod version (original code deleted)
+	if (kSet.isEasyCulture())
+	{
+		// 5/4 * 21 ~= 9 * 1.5 + 12 * 1;
+		r *= 5;
+		r /= 4;
+	}
+	else if (p.getOwner() == ePlayer ||
+		stepDistance(iX, iY, p.getX(), p.getY()) <= 1)
+	{
+		r *= 3;
+		r /= 2;
+	}
+	r *= kSet.getGreed(); // advc (note): Not really part of the culture adjustment
+	r /= 100;
+	// K-Mod end
+	r *= iCultureModifier;
+	r /= 100;
+	// <advc.031>
+	if (bShare) // bSteal is already factored into iCultureModifier
+		r = ::round(r * 0.375);
+	// </advc.031>
+	return r;
+}
