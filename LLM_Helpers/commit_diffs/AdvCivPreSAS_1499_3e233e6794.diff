+bool CvUnitAI::AI_considerPickup(UnitAITypes eUnitAI, CvCity& kCity) const {
+
+	// BETTER_BTS_AI_MOD, Naval AI, 01/23/09, jdog5000: START
+	bool bConsider = false;
