+	CvCity* cap = GET_PLAYER(eTarget).getCapitalCity();
+	if(cap != NULL) {
+		x = cap->getX_INLINE();
+		y = cap->getY_INLINE();
+	}
+	if(GC.getDefineINT("ANNOUNCE_ESPIONAGE_REVOLUTION") > 0) {
