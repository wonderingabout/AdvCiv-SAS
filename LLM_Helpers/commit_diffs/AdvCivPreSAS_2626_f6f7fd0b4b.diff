diff --git a/CvGameCoreDLL/PlayerHistory.cpp b/CvGameCoreDLL/PlayerHistory.cpp
new file mode 100644
index 000000000..de3bca18c
--- /dev/null
+++ b/CvGameCoreDLL/PlayerHistory.cpp
@@ -0,0 +1,66 @@
+#include "CvGameCoreDLL.h"
+#include "PlayerHistory.h"
+#include "CvPlayer.h"
+
+// advc.004s: New implementation file; see comment in header.
+
+void PlayerHistory::set(int iTurn, int iValue)
+{
+	FAssert(iTurn >= 0);
+	while (iTurn >= size())
+		m_aiValues.push_back(-1);
+	if (m_iMovingAvgSamples <= 0)
+	{
+		m_aiValues[iTurn] = iValue;
+		return;
+	}
+	int iOldSamples = std::min(m_iMovingAvgSamples - 1, iTurn - 1);
+	int iSamples = iOldSamples;
+	int iSum = 0;
+	// Discard new sample (iValue) if in anarchy
+	if (!GET_PLAYER(m_eOwner).isAnarchy() || iTurn == 0)
+	{
+		iSum += iValue;
+		iSamples++;
+	}
+	for (int i = iTurn - 1; i >= iTurn - iOldSamples; i--)
+		iSum += std::max(m_aiValues[i], 0);
+	m_aiValues[iTurn] = scaled(iSum, std::max(1, iSamples)).round();
+}
+
+
+void PlayerHistory::read(FDataStreamBase* pStream, PlayerTypes eOwner, bool bLegacy)
+{
+	m_eOwner = eOwner;
+	FAssert(size() == 0);
+	if (bLegacy)
+	{
+		size_t iSize;
+		pStream->Read(&iSize);
+		for (size_t i = 0; i < iSize; i++)
+		{
+			int iTurn;
+			int iValue;
+			pStream->Read(&iTurn);
+			pStream->Read(&iValue);
+			set(iTurn, iValue);
+		}
+		return;
+	}
+	int iSize;
+	pStream->Read(&iSize);
+	if (iSize > 0)
+	{
+		m_aiValues.resize(iSize);
+		pStream->Read(iSize, &m_aiValues[0]);
+	}
+}
+
+
+void PlayerHistory::write(FDataStreamBase* pStream)
+{
+	int iSize = size();
+	pStream->Write(iSize);
+	if (iSize > 0)
+		pStream->Write(iSize, &m_aiValues[0]);
+}

diff --git a/CvGameCoreDLL/PlayerHistory.h b/CvGameCoreDLL/PlayerHistory.h
new file mode 100644
index 000000000..4e2694af2
--- /dev/null
+++ b/CvGameCoreDLL/PlayerHistory.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#ifndef PLAYER_HISTORY_H
+#define PLAYER_HISTORY_H
+
+/*	advc.004s: Replacing CvTurnScoreMap, which was a stdext::hash_map typedef
+	in CvPlayer.h. Since AdvCiv uses player histories for AI decisions, lookup
+	needs to be faster. A custom class also allows for a cleaner implementation
+	of a moving average. */
+class PlayerHistory
+{
+public:
+	PlayerHistory() : m_iMovingAvgSamples(0), m_eOwner(NO_PLAYER) {}
+	void reset(PlayerTypes eOwner, int iMovingAvgSamples = 3)
+	{
+		m_eOwner = eOwner;
+		m_iMovingAvgSamples = iMovingAvgSamples;
+		m_aiValues.clear();
+	}
+	inline int size() const { return (int)m_aiValues.size(); }
+	inline int get(int iTurn) const
+	{
+		FAssertBounds(0, size(), iTurn);
+		return m_aiValues[iTurn];
+	}
+	int getSafe(int iTurn) const
+	{
+		if (iTurn >= size())
+			return -1;
+		return get(iTurn);
+	}
+	void set(int iTurn, int iValue);
+	void read(FDataStreamBase* pStream, PlayerTypes eOwner, bool bLegacy = false);
+	void write(FDataStreamBase* pStream);
+
+private:
+	std::vector<int> m_aiValues; // serialized
+	int m_iMovingAvgSamples;
+	PlayerTypes m_eOwner;
+};
+
+#endif

