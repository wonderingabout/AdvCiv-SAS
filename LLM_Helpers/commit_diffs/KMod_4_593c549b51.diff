+	<symbol id="ss cockpit"/>
+	<symbol id="ss docking bay"/>
+	<symbol id="ss engine"/>
+	<symbol id="ss life support"/>
+	<symbol id="ss stasis chamber"/>
+	<symbol id="ss thruster"/>
+	<symbol id="citizen" from="POWER" offset="1"/>
