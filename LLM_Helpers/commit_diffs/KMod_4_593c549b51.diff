+
+		zStyle = BugAutolog.getFormatStyle()
+		if (zStyle == 2 or zStyle == 3):  # forum styles
+			if vOpenSpoiler != "":
+				sMsg = "[spoiler=%s]%s" % (vOpenSpoiler, sMsg)
+
+			if vCloseSpoiler:
+				sMsg = "%s[/spoiler]" % (sMsg)
+
+		sDump.write(sMsg, bFlush=False, bPending=False)

