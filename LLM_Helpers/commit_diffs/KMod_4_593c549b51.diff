+		iReligion = getBuildingReligion(bldg)
+		if iReligion >= 0:
+			for type in BUILDINGS:
+				if type.matches(bldg, iReligion):
+					BUILDINGS_BY_RELIGION[iReligion][type.index] = iBldg
+					BugUtil.debug("ReligionUtil.init - %s %s is %i: %s", 
