+
+		# if we get to here, then we have a unit in BupUnit and BupUnit_Prior
+		if BupUnit.DotStatus != BupUnit_Prior.DotStatus:
+			self._drawDot(BupUnit, szCell, iCount, x, y)
+
+	def _drawDot(self, BupUnit, szCell, iCount, x, y):
