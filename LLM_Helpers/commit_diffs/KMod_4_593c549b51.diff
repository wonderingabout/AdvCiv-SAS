+		<arg name="modifiers" type="tuple">
+			"TXT_KEY_MISC_ATTITUDE_LAND_TARGET",
+			"TXT_KEY_MISC_ATTITUDE_WAR",
+			"TXT_KEY_MISC_ATTITUDE_PEACE",
+			"TXT_KEY_MISC_ATTITUDE_SAME_RELIGION",
