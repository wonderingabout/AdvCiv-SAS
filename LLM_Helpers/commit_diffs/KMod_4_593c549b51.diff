+						lUnitCombatModifierPercent[ii] += iTemp
+				
+	if bBlitz:
+		szPromotionInfo += localText.getText("TXT_KEY_PROMOTION_BLITZ_TEXT", ()) + "\n"
+	if bAmphib:
