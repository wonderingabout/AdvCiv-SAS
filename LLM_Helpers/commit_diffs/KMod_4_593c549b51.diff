+		self.screen.enable(szCell, BupUnit.Owner == gc.getGame().getActivePlayer())
+		self.screen.show(szCell)
+#		self.screen.setState(szCell, BupUnit.isSelected)
+
+		self.BupCell_Displayed[iIndex] = True
