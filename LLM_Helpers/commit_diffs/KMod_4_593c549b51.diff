+			else:
+				for j in range(gc.getNUM_UNIT_PREREQ_OR_BONUSES()):
+					if (gc.getUnitInfo(iUnit).getPrereqOrBonuses(j) == iBonus):
+						iValue = player.AI_unitValue(iUnit, UnitAITypes.UNITAI_ATTACK, plot.area())
+						break
+			if iValue > iBestValue:
