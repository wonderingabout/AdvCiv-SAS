+			<!-- Great Person Info by Chinese American, EmperorFool -->
+			<option id="GreatPersonTurns" key="Great Person Turns" 
+					type="boolean" default="False" 
+					get="isShowGreatPersonTurns" dirtyBit="CityScreen"/>
