+					UNITS_BY_RELIGION[iReligion][type.index] = iUnit
+					BugUtil.debug("ReligionUtil.init - %s %s is %i: %s", 
+								gc.getReligionInfo(iReligion).getDescription(), type.description, iUnit, unit.getDescription())
+					break
