+# SevoPediaTrait
+#
+# Copyright (c) 2008 The BUG Mod.
+
+from CvPythonExtensions import *
+import CvUtil
+import ScreenInput
+import SevoScreenEnums
+import string
+
+import TraitUtil
+
+gc = CyGlobalContext()
+ArtFileMgr = CyArtFileMgr()
