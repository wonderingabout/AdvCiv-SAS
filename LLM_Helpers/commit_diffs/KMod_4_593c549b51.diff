+	# performs the units promotion
+	def doPromotion(self, id):
+		idPromo		= id % 100
+		idUnit		= id / 100
+		if self.sPLEMode == self.PLE_MODE_STACK_HORIZ:
+			idButton = self.getI(idUnit, 0)
+		else:
