+	PlayerTypes const ePlayer = getLeaderID();
+	// <K-Mod>
+	return kPlot.plotCheck(PUF_isPotentialEnemy, ePlayer, false,
+			NO_PLAYER, NO_TEAM, PUF_isVisible, ePlayer); // </K-Mod>
+}
