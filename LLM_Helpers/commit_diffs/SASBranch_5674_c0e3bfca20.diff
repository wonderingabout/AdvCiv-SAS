+
+	if bExpanded:
+		iOverlayX = top.X_PEDIA_PAGE
+		iOverlayY = top.Y_PEDIA_PAGE
+		iOverlayW = top.R_PEDIA_PAGE - top.X_PEDIA_PAGE
+		iOverlayH = top.B_PEDIA_PAGE - top.Y_PEDIA_PAGE
