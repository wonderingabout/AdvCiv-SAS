+		iExpandButtonW,
+		24,
+		WidgetTypes.WIDGET_PYTHON,
+		iPythonWidgetData1,
+		1,
+		ButtonStyles.BUTTON_STYLE_STANDARD
+	)
+	if panelTitle:
