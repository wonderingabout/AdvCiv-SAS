@@ -0,0 +1,93 @@
+<?xml version="1.0" encoding="ISO-8859-1"?>
+<!-- edited by karadoc, using an ordinary text editor -->
+<!-- Sid Meier's Civilization 4 -->
+<!-- Copyright Firaxis Games 2005 -->
+<!-- -->
+<!-- Game Text Infos -->
+<Civ4GameText xmlns="http://www.firaxis.com">
+	<!-- K-Mod trade culture -->
+	<TEXT>
+		<Tag>TXT_KEY_MISC_HELP_TRADE_CULTURE</Tag>
+		<English>[ICON_BULLET]%s1[ICON_CULTURE] from [ICON_TRADE]</English>
