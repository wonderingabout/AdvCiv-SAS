+		<Spanish>[ICON_BULLET]%s1[ICON_CULTURE] por [ICON_TRADE]</Spanish>
+	</TEXT>
+	<!-- Global warming text -->
+	<TEXT>
+		<Tag>TXT_KEY_ENVIRONMENTAL_ADVISOR_TITLE</Tag>
+		<English>Environmental Advisor</English>
+		<French>Environnement</French>
+		<German>Umwelt</German>
+		<Italian>Ambiente</Italian>
+		<Spanish>Medio Ambiente</Spanish>
+	</TEXT>
+	<!-- TODO: get translations for the following keys. -->
+	<TEXT>
+		<Tag>TXT_KEY_MISC_GLOBAL_WARMING_ACTIVE</Tag>
+		<English>Worldwide pollution has reached the sustainability threshold.</English>
+		<French>Worldwide pollution has reached the sustainability threshold.</French>
+		<German>Worldwide pollution has reached the sustainability threshold.</German>
+		<Italian>Worldwide pollution has reached the sustainability threshold.</Italian>
+		<Spanish>Worldwide pollution has reached the sustainability threshold.</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_POPUP_ENVIRONMENTAL_ADVISOR</Tag>
+		<English>Our scientists have theorized that if worldwide pollution output continues to increase, we may be faced with irreversible climate change. We have appointed an environmental advisor to provide you with further information. (See the economics screen; F2)</English>
+		<French>Our scientists have theorized that if worldwide pollution output continues to increase, we may be faced with irreversible climate change. We have appointed an environmental advisor to provide you with further information. (See the economics screen; F2)</French>
+		<German>Our scientists have theorized that if worldwide pollution output continues to increase, we may be faced with irreversible climate change. We have appointed an environmental advisor to provide you with further information. (See the economics screen; F2)</German>
+		<Italian>Our scientists have theorized that if worldwide pollution output continues to increase, we may be faced with irreversible climate change. We have appointed an environmental advisor to provide you with further information. (See the economics screen; F2)</Italian>
+		<Spanish>Our scientists have theorized that if worldwide pollution output continues to increase, we may be faced with irreversible climate change. We have appointed an environmental advisor to provide you with further information. (See the economics screen; F2)</Spanish>
+	</TEXT>
+	<TEXT>
+		<Tag>TXT_KEY_UNHEALTHY_POP_MODIFIER</Tag>
