s:[NEWLINE]- Conquest -> getConquestVictoryWeight.[NEWLINE]- Domination -> getDominationVictoryWeight.[NEWLINE]- Culture -> getCultureVictoryWeight.[NEWLINE]- Diplomacy -> getDiplomacyVictoryWeight.[NEWLINE]- Space -> getSpaceVictoryWeight.[NEWLINE][NEWLINE]Flavors:[NEWLINE]- Military -> iFlavorMilitary.[NEWLINE]- Religion -> iFlavorReligion.[NEWLINE]- Production -> iFlavorProduction.[NEWLINE]- Gold -> iFlavorGold.[NEWLINE]- Science -> iFlavorScience.[NEWLINE]- Culture -> iFlavorCulture.[NEWLINE]- Growth -> iFlavorGrowth.[NEWLINE]- Espionage -> iFlavorEspionage.[NEWLINE][NEWLINE]War Strategy:[NEWLINE]- T.W Likely -> getMaxWarRand (Inverted).[NEWLINE]- T.W NearPR -> getMaxWarNearbyPowerRatio.[NEWLINE]- T.W DistPR -> getMaxWarDistantPowerRatio.[NEWLINE]- T.W MinNearPR -> getMaxWarMinAdjacentLandPercent (Inverted).[NEWLINE]- Lim.W Likely -> getLimitedWarRand (Inverted).[NEWLINE]- Lim.W PR -> getLimitedWarPowerRatio.[NEWLINE]- Risky Aggr -> getBaseAttackOddsChange.[NEWLINE]- Risky AggrRand+ -> getAttackOddsChangeRand.[NEWLINE]- Raz C % -> getRazeCityProb.[NEWLINE]- TribRSneakW% -> getDemandRebukedSneakProb.[NEWLINE]- TribRef W% -> getDemandRebukedWarProb.[NEWLINE]- Dogpile Likely -> getDogpileWarRand (Inverted).[NEWLINE]- WAllianceMaker -> getDeclareWarTradeRand.[NEWLINE]- Share W ACL -> getShareWarAttitudeChangeLimit.[NEWLINE]- ResistCapitulPM -> getVassalPowerModifier.[NEWLINE]- Ref2TalkWSpan -> getRefuseToTalkWarThreshold.[NEWLINE]- MakePeaceLikely -> getMakePeaceRand (Inverted).[NEWLINE][NEWLINE]Economic Preferences:[NEWLINE]- Max Gold Tr% -> getMaxGoldTradePercent.[NEWLINE]- Max GPT Tr% -> getMaxGoldPerTurnTradePercent.[NEWLINE]- NoTechYetRdy% -> getTechTradeKnownPercent.[NEWLINE]- NoTech2AdvT -> getNoTechTradeThreshold (Inverted).[NEWLINE]- Build Unit % -> getBuildUnitProb.[NEWLINE]- Wonder C.R -> getWonderConstructRand.[NEWLINE]- EspionageWeig -> getEspionageWeight.[NEWLINE][NEWLINE]Contact Offer Probabilities:[NEWLINE]- PeaceTreaty -> iAggregatedContactProbPeace