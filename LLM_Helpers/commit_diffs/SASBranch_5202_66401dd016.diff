diff --git a/Assets/XML/GlobalDefines_advciv_sas.xml b/Assets/XML/GlobalDefines_advciv_sas.xml
index 9249ba7ce..73c879905 100644
--- a/Assets/XML/GlobalDefines_advciv_sas.xml
+++ b/Assets/XML/GlobalDefines_advciv_sas.xml
@@ -559,15 +559,76 @@
 		<DefineName>SAS_AI_BUILDING_VALUE_REGULAR_BUILDINGS_OPTIMIZE</DefineName>
 		<iDefineIntVal>1</iDefineIntVal>
 	</Define>
-	<!-- custom: knob common to all wonders, see below for more specific ones alternatively i mean if i may say but anyways etc -->
+	<!-- custom: knob common to all wonders, see below for more specific ones alternatively i mean if i may say but anyways etc. -->
 	<Define>
 		<DefineName>SAS_AI_BUILDING_VALUE_WONDERS_OPTIMIZE</DefineName>
 		<iDefineIntVal>1</iDefineIntVal>
 	</Define>
+	<!-- custom: knob common to all world wonders, see below for more specific ones alternatively i mean if i may say but anyways etc. -->
+	<!-- custom: update: in autoplay, the SAS_AI_BUILDING_VALUE_WORLD_WONDERS_OPTIMIZE check specifically greatly reduces the number of early wonders (0 wonders vs 6 wonders at turn 100 with vs without it, everything else being the same). Tune below sub-kobs if you want more precision, or to restore a more base advciv like behaviour of wonder building, disable SAS_AI_BUILDING_VALUE_WORLD_WONDERS_OPTIMIZE entirely. I believe building settlers or workers is generally stronger especially early, so i kept the "optimize" flag enabled i mean but anyways etc. But you can disable it if you want a more wonder-building like behaviour, or maybe rather one of the sub-knobs as you prefer (but it can quickly become a rabbit hole xd so beware i mean if i may say but anyways etc.). See below to specifically tune its suboptions rather anyways etc. Code added with the help of chatgpt 5.2 thanks anyways etc. -->
 	<Define>
 		<DefineName>SAS_AI_BUILDING_VALUE_WORLD_WONDERS_OPTIMIZE</DefineName>
 		<iDefineIntVal>1</iDefineIntVal>
 	</Define>
+	<!-- Min base-hammers gate for wonders (used in CvCityAI::AI_buildingValue)
+	Formula: reject if iBaseHammersPerTurn < (MIN_BASE + iCurrentEra * EXTRA_PER_ERA)
+
+	Important: this gate uses BASE hammers per turn (iBaseHammersPerTurn), i.e. hammers before production multipliers are applied
+	(stone/marble, traits, civics, forge/factory, etc). Production multipliers are handled separately later via getProductionModifier() and iTurnsWW.
+
+	Assume iCurrentEra is 0-based: Era0=0, Era1=1, Era2=2, Era3=3, Era4=4
+
+	Examples (using the values below):
+	World wonders:   MIN_BASE=6,  EXTRA=3  => Era0=6,  Era1=9, Era2=12, Era3=15, Era4=18
+	National wonders:MIN_BASE=6,  EXTRA=2  => Era0=6,  Era1=8, Era2=10, Era3=12, Era4=14
+	Unknown wonders: MIN_BASE=6,  EXTRA=2  => Era0=6,  Era1=8, Era2=10, Era3=12, Era4=14
+
