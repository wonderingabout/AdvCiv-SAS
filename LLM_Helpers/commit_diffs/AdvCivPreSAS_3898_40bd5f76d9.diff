+		<element type="iFullTradeCreditPercent" minOccurs="0"/>
+		<!-- advc.101: Adjusts the per-turn revolt probability in cities.
+			 The probability gets divided by this percentage, i.e. values above
+			 100 make cities less likely to revolt.
+			 No impact on the occupation countdown. -->
+		<element type="iRevoltDivPercent" minOccurs="0"/>
+		<!-- advc.173: Adjusts the per-turn probability of passive
