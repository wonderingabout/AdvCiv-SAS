+bool CvUnitAI::AI_nukeRange(int iRange)
+{
+	PROFILE_FUNC();
+
+	int iThresholdValue = 60 + std::max(0, 3 * getUnitInfo().getProductionCost());
+	if (!GET_PLAYER(getOwnerINLINE()).AI_getAnyPlotDanger(plot(), DANGER_RANGE))
