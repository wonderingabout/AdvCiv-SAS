+			return self.SAS_cacheCorporationsTuple
+		else:
+			if self.SAS_cacheCorporationsTuple is None:
+				self.SAS_cacheCorporationsTuple = tuple(self.getSortedList(gc.getNumCorporationInfos(), gc.getCorporationInfo))
