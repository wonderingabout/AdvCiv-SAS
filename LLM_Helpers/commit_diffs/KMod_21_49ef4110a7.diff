+gc = CyGlobalContext()
+ArtFileMgr = CyArtFileMgr()
+localText = CyTranslator()
+
+class CvPediaPromotion:
+	"Civilopedia Screen for Promotions"
+
+	def __init__(self, main):
+		self.iPromotion = -1
+		self.top = main
+	
+		self.BUTTON_SIZE = 46
+		
+		self.X_UNIT_PANE = 50
+		self.Y_UNIT_PANE = 80
+		self.W_UNIT_PANE = 250
+		self.H_UNIT_PANE = 210
+
