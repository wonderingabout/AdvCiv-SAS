+// <advc.104> New classes; see WarAndPeaceAI.h.
+
+#include "CvGameCoreDLL.h"
+#include "WarAndPeaceAgent.h"
+#include "WarEvaluator.h"
+#include "WarAndPeaceReport.h"
+#include "WarEvalParameters.h"
