+double WarAndPeaceAI::Civ::humanBuildUnitProb() const {
+
+	CvPlayer& human = GET_PLAYER(weId);
+	double r = 0.25; // 30 is about average, Gandhi 15
+	if(human.getCurrentEra() == 0)
+		r += 0.1;
