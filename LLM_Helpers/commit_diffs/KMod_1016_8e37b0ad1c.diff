 		if (AI_isAnyMemberDoVictoryStrategy(AI_VICTORY_DIPLOMACY4))
 			iDiploWeight += 50;
+		if (AI_isAnyMemberDoVictoryStrategy(AI_VICTORY_CONQUEST3)) // note: conquest4 ignores diplo completely.
+			iDiploWeight /= 2;
 
 		iDiploCost *= iDiploWeight;
 		iDiploCost /= 100;
 	}
 
