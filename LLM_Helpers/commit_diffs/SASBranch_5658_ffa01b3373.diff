diff --git a/CvGameCoreDLL/CvDLLInterfaceIFaceBase.cpp b/CvGameCoreDLL/CvDLLInterfaceIFaceBase.cpp
index 5a596f7c8..f6d2d29e4 100644
--- a/CvGameCoreDLL/CvDLLInterfaceIFaceBase.cpp
