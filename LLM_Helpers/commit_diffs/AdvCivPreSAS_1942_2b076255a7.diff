diff --git a/Assets/XML/GlobalDefines_advc.xml b/Assets/XML/GlobalDefines_advc.xml
index 663dd5e99..3fb0760b4 100644
--- a/Assets/XML/GlobalDefines_advc.xml
+++ b/Assets/XML/GlobalDefines_advc.xml
@@ -1151,4 +1151,18 @@
 		<iDefineIntVal>1</iDefineIntVal>
 	</Define>
 
+	<!-- advc.exp.1: In the formula for the number-of-cities maintenance cost,
+		 the player's city count (including half the number of vassal cities)
+		 gets capped at an upper bound equal to MAX_CITY_COUNT_FOR_MAINTENANCE
+		 divided by (100+iNumCitiesMaintenancePercent); see Civ4WorldInfo
+		 about the divisor. Recommended: 45 (not tested much; should only
+		 matter for military victories on Huge and possibly Large maps).
+		 BtS behavior (a cap between 4 and 8) can be restored through
+		 Civ4HandicapInfos.xml and MAX_CITY_COUNT_FOR_MAINTENANCE > 7.
+		 Use a very high value, say, 1000, for K-Mod behavior (no cap). -->
+	<Define>
+		<DefineName>MAX_CITY_COUNT_FOR_MAINTENANCE</DefineName>
+		<iDefineIntVal>45</iDefineIntVal>
+	</Define>
+
 </Civ4Defines>

