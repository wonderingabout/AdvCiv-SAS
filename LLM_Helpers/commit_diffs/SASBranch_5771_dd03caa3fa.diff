+    global g_iSasPediaBgIdx
+    init_sas_pedia_playground_cache()
+    iCount = len(SAS_PEDIA_BG_NAMES)
+    if iCount > 0:
+        g_iSasPediaBgIdx = (g_iSasPediaBgIdx + iDelta) % iCount
