-# --- Convert CIV4HandicapInfo.xml to CSV with Full Difficulty Settings and Goody Table ---
-# This script is part of the AdvCiv-SAS mod project.
-# (c) 2025 wonderingabout & AI helpers (see Authors in root README.md)
-#
-# This script extracts and formats all game difficulty settings from CIV4HandicapInfo.xml
-# into structured, spreadsheet-friendly output files suitable for data analysis or mod balancing.
-#
-# It parses each <HandicapInfo> entry and produces:
-# - A CSV file with one row per numeric or structured field (e.g. iAIBarbarianBonus, iTrainPercent)
-# - One column per difficulty (e.g. Settler → Deity), with beautified headers (e.g. "HANDICAP_PRINCE" → "Prince")
-#
-# Special handling is applied to:
-#
-# 1. <Goodies>:
-#	- All GOODY_* entries (e.g. GOODY_LOW_GOLD, GOODY_SCOUT) are flattened into explicit fields.
-#	- Output field names preserve their original enum format (e.g. "GOODY_TECH").
-#	- In the CSV, each goody field is labeled with "(*)", and its behavior is explained in a separate Markdown footnote file.
-#
-# 2. <FreeTechs> and <AIFreeTechs>:
-#	- These are parsed as comma-separated strings per difficulty.
-#	- Long values are replaced by short legend keys (e.g. FT_0, AIFT_0), defined in `ABBREV_FREE_TECHS_HEADER_NAMES`.
-#	- Technology names inside the legend are optionally shortened via `ABBREV_TECH_NAMES` (e.g. "Animal Husbandry" → "Animal H.").
-#	- A right-shifted [LEGEND] block in the CSV aligns the mappings compactly.
-#
-# Output Files:
-# - CSV table of all difficulty settings (main output)
-# - Markdown legend file (footnotes + abbreviation keys), designed for GitHub compatibility
-# - Optional Markdown table output (disabled in AdvCiv-SAS but preserved for reference)
-#
-# Other Features:
-# - Beautification of difficulty level names (e.g. HANDICAP_IMMORTAL → Immortal)
-# - Manual repositioning of nested fields (e.g. GoodyTypes, FreeTechs) after a fixed anchor
-# - Consistent column widths, right-shifted legends, and zero malformed rows for clean GitHub rendering
-
-import csv
-import xml.etree.ElementTree as ET
-from datetime import datetime
-import re
-
-# --- Step 1: Setup paths ---
-XML_PATH = r"Assets\XML\GameInfo\CIV4HandicapInfo.xml"
-timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
-table_csv_filename = f"handicap_info_to_csv_{timestamp}.csv"
-# <!-- custom: .md table output is disabled by default; CSV/legend is preferred but the option is kept. (GPT-5.2-Codex (summarized)) -->
-#table_md_filename = f"handicap_info_to_md_{timestamp}.md"
-legend_md_filename = f"handicap_info_legend_{timestamp}.md"
-
-# --- Step 2: Parse XML ---
-tree = ET.parse(XML_PATH)
-root = tree.getroot()
-
-# --- Step 3: Collect all HandicapInfo entries ---
-namespace = {'ns': root.tag.split('}')[0].strip('{')}
-handicap_infos = root.find('ns:HandicapInfos', namespace)
-all_fields = set()
-parsed_data = {}
-
-# <!-- custom: Goody type meanings from https://gforestshade.github.io/kujira/post/keyichiran/#%E9%83%A8%E6%97%8F%E9%9B%86%E8%90%BD (translated). Credit: ChatGPT. Mapping:
-# GOODY_LOW_GOLD -> Gold (small)
-# GOODY_HIGH_GOLD -> Gold (many)
-# GOODY_MAP -> Map
-# GOODY_SETTLER -> Settler
-# GOODY_WARRIOR -> Warrior
-# GOODY_SCOUT -> Scout
-# GOODY_WORKER -> Laborer
-# GOODY_EXPERIENCE -> Experience Points
-# GOODY_HEALING -> Recovery
-# GOODY_TECH -> Tech
-# GOODY_BARBARIANS_WEAK -> Hostile (weak)
-# GOODY_BARBARIANS_STRONG -> Hostile (strong). (GPT-5.2-Codex (summarized)) -->
-ALL_GOODY_TYPES = (
-	"GOODY_LOW_GOLD",
-	"GOODY_HIGH_GOLD",
-	"GOODY_MAP",
-	"GOODY_SETTLER",
-	"GOODY_WARRIOR",
-	"GOODY_SCOUT",
-	"GOODY_WORKER",
-	"GOODY_EXPERIENCE",
-	"GOODY_HEALING",
-	"GOODY_TECH",
-	"GOODY_BARBARIANS_WEAK",
-	"GOODY_BARBARIANS_STRONG",
-)
-
-ABBREV_FREE_TECHS_HEADER_NAMES = {
-	"AIFreeTechs": "AIFT_",
-	"FreeTechs":"FT_",
-}
-
-ABBREV_TECH_NAMES = {
-	"Animal Husbandry": "Animal H.",
-	"Bronze Working": "Bronze W.",
-	"Iron Working": "Iron W.",
-	"Industrialism": "Industr.",
-}
-
-def beautify_enum_name(raw_name):
-	# Convert raw enum strings like 'TECH_THE_WHEEL',
-	# 'HANDICAP_NOBLE' into human-readable display forms like:
-	# 'The Wheel', 'Noble'
-
-	# Remove known Civ4 enum prefixes
-	for prefix in ('TECH_', 'HANDICAP_'):
-		if raw_name.startswith(prefix):
-			raw_name = raw_name[len(prefix):]
-			break
-
-	# Underscore to space, then title case
-	return re.sub(r'_', ' ', raw_name).title()
-
-def shorten_legend_name(name, abbrev_tech_names):
-	return abbrev_tech_names.get(name, name)
-
-for handicap_info in handicap_infos.findall('ns:HandicapInfo', namespace):
-	handicap_dict = {}
-	handicap_type = handicap_info.find('ns:Type', namespace).text
-
-	for elem in handicap_info:
-		tag = elem.tag.split('}')[-1]
-		if tag in ("Type", "Description", "Help"):
-			continue
-
-		elif tag in ("Goodies"):
-			# Count occurrences of each GoodyType
-			goody_counts = {gt: 0 for gt in ALL_GOODY_TYPES}
-
-			for goody_elem in elem.findall('ns:GoodyType', namespace):
-				goody = goody_elem.text.strip()
-				if goody in goody_counts:
-					goody_counts[goody] += 1
-
-			# Flatten into individual fields
-			for gt in ALL_GOODY_TYPES:
-				field_name = gt  # Just use the original full enum name
-				handicap_dict[field_name] = str(goody_counts[gt])
-
-		elif tag in ("FreeTechs", "AIFreeTechs"):
-			# Serialize list fields as comma-separated strings
-			entries = []
-			for child in elem.findall('.//*'):
-				tagname = child.tag.split('}')[-1]
-				if tagname not in ("TechType", "GoodyType"):
-					continue
-				text = child.text.strip() if child.text else ""
-				if text:
-					entries.append(text)
-			handicap_dict[tag] = ', '.join(entries)
-		else:
-			if elem.text:
-				handicap_dict[tag] = elem.text.strip()
-
-	all_fields.update(handicap_dict.keys())
-	parsed_data[handicap_type] = handicap_dict
-
-# --- Step 4: Prepare CSV rows ---
-all_fields = sorted(all_fields)
-difficulty_types = list(parsed_data.keys())  # Preserve order from XML parse loop
-
-rows = []
-for field in all_fields:
-	row = {'Field': field}
-	for difficulty in difficulty_types:
-		row[difficulty] = parsed_data[difficulty].get(field, "")
-	rows.append(row)
-
-# --- Step 4.5: Move nested fields to a fixed location ---
-GOODY_FIELDS = tuple(sorted(gt for gt in ALL_GOODY_TYPES if gt in all_fields))
-NESTED_FIELDS = ("AIFreeTechs", "FreeTechs")
-ANCHOR_FIELD = "iUnownedWaterTilesPerBarbarianUnit"
-
-# Split rows into parts
-before = []
-goody_rows = []
-nested = []
-
-for row in rows:
-	if row["Field"] in GOODY_FIELDS:
-		goody_rows.append(row)
-	elif row["Field"] in NESTED_FIELDS:
-		nested.append(row)
-	else:
-		before.append(row)
-
-# Reinsert in proper order
-new_rows = []
-for row in before:
-	new_rows.append(row)
-	if row["Field"] == ANCHOR_FIELD:
-		new_rows.extend(goody_rows)
-		new_rows.extend(nested)
-rows = new_rows
-
-# --- Step 5: Prepare columns ---
-# Create a map of full -> short column headers
-difficulty_column_map = {
-	difficulty: beautify_enum_name(difficulty)
-	for difficulty in parsed_data.keys()
-}
-columns = ['Field'] + list(difficulty_column_map.values())
-
-# --- Step 6: Replace long values with references and collect legend ---
-legend = {}
-legend_counter = {}
-
-def get_legend_key(field_name, value):
-	if not value.strip():
-		return ""
-
-	count = legend_counter.get(ABBREV_FREE_TECHS_HEADER_NAMES[field_name], 0)
-	legend_key = f"{ABBREV_FREE_TECHS_HEADER_NAMES[field_name]}{count}"
-	legend_counter[ABBREV_FREE_TECHS_HEADER_NAMES[field_name]] = count + 1
-	legend[legend_key] = value
-	return legend_key
-
-for row in rows:
-	for difficulty in difficulty_types:
-		value = row.get(difficulty, "")
-		# This ensures all values (even single items) in the specified fields are always substituted with a legend key, no matter the length.
-		if row["Field"] in ("FreeTechs", "AIFreeTechs"):
-			row[difficulty] = get_legend_key(row["Field"], value)
-
-# --- Step 7: Write CSV with right-shifted legend ---
-with open(table_csv_filename, "w", newline="", encoding="utf-8") as f:
-	writer = csv.DictWriter(f, fieldnames=columns)
-	writer.writeheader()
-
-	for row in rows:
-		field_name = row['Field']
